  shorttitle = {Genes {{Associated}} with {{Thoracic Aortic Aneurysm}} and {{Dissection}}},
  author = {Brownstein, Adam and Kostiuk, Valentyna and Ziganshin, Bulat and Zafar, Mohammad and Kuivaniemi, Helena and Body, Simon and Bale, Allen and Elefteriades, John},
