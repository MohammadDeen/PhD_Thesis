@article{friendCluesResilient2014,
  title = {Clues from the Resilient},
  author = {Friend, Stephen H. and Schadt, Eric E.},
  date = {2014-05-30},
  journaltitle = {Science},
  shortjournal = {Science},
  volume = {344},
  number = {6187},
  pages = {970--972},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.1255648},
  url = {https://www.science.org/doi/10.1126/science.1255648},
  urldate = {2026-05-22},
  abstract = {Genetic information from individuals who do not succumb to disease may point to new therapies and ideas about wellness           ,                             The genetics approach to uncovering the causes of disease has focused mainly on finding the underlying primary mutations, with diseased individuals playing the leading role in this discovery. But as health care begins to focus more on preventive therapies, an emphasis on understanding how individuals remain healthy—“resilient” to disease—may provide insights into disease pathogenesis and new treatments. This view underlies “The Resilience Project” (               www.resilienceproject.me               ), an effort to search broadly for these apparently healthy people (see the photo). There are, indeed, individuals whose genetics indicate exceptionally high risk of disease, yet they never show any signs of the disorder. What are the genetic and environmental factors that buffer disease for them? How can such information be gathered and harnessed most efficiently and effectively?},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\RXHSILSK\Friend and Schadt - 2014 - Clues from the resilient.pdf}
}

