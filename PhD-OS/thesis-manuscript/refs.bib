@article{mishraDisruptedDegradativeSorting2024,
  title = {Disrupted Degradative Sorting of {{TLR7}} Is Associated with Human Lupus},
  author = {Mishra, Harshita and Schlack-Leigers, Claire and Lim, Ee Lyn and Thieck, Oliver and Magg, Thomas and Raedler, Johannes and Wolf, Christine and Klein, Christoph and Ewers, Helge and Lee-Kirsch, Min Ae and Meierhofer, David and Hauck, Fabian and Majer, Olivia},
  date = {2024-02-23},
  journaltitle = {Science Immunology},
  shortjournal = {Sci. Immunol.},
  volume = {9},
  number = {92},
  pages = {eadi9575},
  issn = {2470-9468},
  doi = {10.1126/sciimmunol.adi9575},
  url = {https://www.science.org/doi/10.1126/sciimmunol.adi9575},
  urldate = {2026-05-22},
  abstract = {Hyperactive TLR7 signaling has long been appreciated as driver of autoimmune disease in mouse models. Recently, gain-of-function mutations in TLR7 were identified as a monogenic cause of human lupus. TLR7 is an intracellular transmembrane receptor, sensing RNA breakdown products within late endosomes. Here, we show that endosome dysfunction leads to unrestricted TLR7 signaling and is associated with human lupus. The late endosomal BORC complex together with the small GTPase Arl8b controls intracellular TLR7 levels by regulating receptor turnover. This requires a direct interaction between the TLR7-associated trafficking factor Unc93b1 and Arl8b. We identified an UNC93B1 mutation in a patient with childhood-onset lupus, which results in reduced BORC interaction and endosomal TLR7 accumulation. Therefore, a failure to control TLR7 turnover is sufficient to break immunological tolerance to nucleic acids. Our results highlight the importance of an intact endomembrane system in preventing pathological TLR7 signaling and autoimmune disease.           ,              The BORC complex prevents human autoimmune disease by controlling endosomal TLR7 levels.           ,              Editor’s summary                            Toll-like receptor (TLR) 7 activates innate immune signaling after recognition of endosomal single-stranded RNA but is also believed to contribute to the development of autoimmunity. In four patients with childhood-onset lupus, Wolf               et al               . identified variants in the transmembrane chaperone protein UNC93B1 that led to TLR7 hyperactivation and constitutive type I interferon production. Mishra               et al               . also identified a patient with lupus bearing a mutation in UNC93B1 that disrupted its interaction with the endosomal BORC complex, which they found controlled homeostatic TLR7 turnover. Together, these findings demonstrate that disruptions to TLR7’s regulatory machinery can contribute to human autoimmune disease. See related Research Article by Wolf               et al               . in this issue. —Claire Olingy},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\KRT78796\Mishra et al. - 2024 - Disrupted degradative sorting of TLR7 is associated with human lupus.pdf}
}

@online{mishraEndosomeDysfunctionLeads2023,
  title = {Endosome Dysfunction Leads to Gain-of-Function {{TLR7}} and Human Lupus},
  author = {Mishra, Harshita and Schlack-Leigers, Claire and Lim, Ee Lyn and Thieck, Oliver and Magg, Thomas and Raedler, Johannes and Wolf, Christine and Klein, Christoph and Ewers, Helge and Lee-Kirsch, Min Ae and Meierhofer, David and Hauck, Fabian and Majer, Olivia},
  date = {2023-04-03},
  eprinttype = {Immunology},
  doi = {10.1101/2023.04.03.535356},
  url = {http://biorxiv.org/lookup/doi/10.1101/2023.04.03.535356},
  urldate = {2026-05-22},
  abstract = {Abstract                        Hyperactive Toll-like receptor (TLR) 7 signaling has long been appreciated as a driver of autoimmune disease by breaking tolerance to self-nucleic acids in mouse models             1–5             . Recently, mutations in TLR7 or its associated regulator UNC93B1             6, 7             , were identified as monogenic causes of human lupus; the unifying feature of these mutations being TLR7 gain-of-function. TLR7 is an intracellular transmembrane receptor, sensing RNA breakdown products within late endosomes             8, 9             . Hence, its function depends on intricate transport mechanisms and membrane interactions within the endomembrane network. Whether perturbations of any of these endosome-related processes can give rise to TLR7 gain-of-function and facilitate self-reactivity has not been investigated. Here, we show that a dysregulated endosomal compartment leads to unrestricted TLR7 signaling and human lupus. The late endosomal BLOC-1-related protein complex (BORC) together with the small Arf1-like GTPase Arl8b controls TLR7 protein levels, and a direct interaction between Arl8b and Unc93b1 is required to regulate TLR7 turnover. We identified an amino acid insertion in UNC93B1 in a patient with childhood-onset lupus, which reduces the interaction with the BORC-Arl8b complex and leads to endosomal TLR7 accumulation. Therefore, a failure to control the proper progression of TLR7 through its endocytic life cycle is sufficient to break immunological tolerance to nucleic acids in humans. Our results highlight the importance of an intact endomembrane system to prevent autoimmune disease. As the cellular mechanisms restricting TLR7 signaling can be manifold, identifying and stratifying lupus patients based on a TLR7-driven pathogenesis could be a viable strategy towards a targeted therapy.},
  langid = {english},
  pubstate = {prepublished},
  file = {C:\Users\hayatumd\Zotero\storage\DWHUIPGB\Mishra et al. - 2023 - Endosome dysfunction leads to gain-of-function TLR7 and human lupus.pdf}
}

