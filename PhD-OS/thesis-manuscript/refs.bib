@article{watanabeFunctionalMappingAnnotation2017,
  title = {Functional Mapping and Annotation of Genetic Associations with {{FUMA}}},
  author = {Watanabe, Kyoko and Taskesen, Erdogan and Van Bochoven, Arjen and Posthuma, Danielle},
  date = {2017-11-28},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {8},
  number = {1},
  pages = {1826},
  issn = {2041-1723},
  doi = {10.1038/s41467-017-01261-5},
  url = {https://www.nature.com/articles/s41467-017-01261-5},
  urldate = {2026-05-22},
  abstract = {Abstract             A main challenge in genome-wide association studies (GWAS) is to pinpoint possible causal variants. Results from GWAS typically do not directly translate into causal variants because the majority of hits are in non-coding or intergenic regions, and the presence of linkage disequilibrium leads to effects being statistically spread out across multiple variants. Post-GWAS annotation facilitates the selection of most likely causal variant(s). Multiple resources are available for post-GWAS annotation, yet these can be time consuming and do not provide integrated visual aids for data interpretation. We, therefore, develop FUMA: an integrative web-based platform using information from multiple biological resources to facilitate functional annotation of GWAS results, gene prioritization and interactive visualization. FUMA accommodates positional, expression quantitative trait loci (eQTL) and chromatin interaction mappings, and provides gene-based, pathway and tissue enrichment results. FUMA results directly aid in generating hypotheses that are testable in functional experiments aimed at proving causal relations.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\6EDBK6AI\Watanabe et al. - 2017 - Functional mapping and annotation of genetic associations with FUMA.pdf}
}

