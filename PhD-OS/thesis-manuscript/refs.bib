@article{takezakiChronicMucocutaneousCandidiasis2012,
  title = {Chronic {{Mucocutaneous Candidiasis Caused}} by a {{Gain-of-Function Mutation}} in the {{STAT1 DNA-Binding Domain}}},
  author = {Takezaki, Shunichiro and Yamada, Masafumi and Kato, Masahiko and Park, Myoung-ja and Maruyama, Kenichi and Yamazaki, Yasuhiro and Chida, Natsuko and Ohara, Osamu and Kobayashi, Ichiro and Ariga, Tadashi},
  date = {2012-08-01},
  journaltitle = {The Journal of Immunology},
  volume = {189},
