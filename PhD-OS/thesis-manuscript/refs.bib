@article{zoccalOpposingRolesLTB42016,
  title = {Opposing Roles of {{LTB4}} and {{PGE2}} in Regulating the Inflammasome-Dependent Scorpion Venom-Induced Mortality},
  author = {Zoccal, Karina F. and Sorgi, Carlos A. and Hori, Juliana I. and Paula-Silva, Francisco W. G. and Arantes, Eliane C. and Serezani, Carlos H. and Zamboni, Dario S. and Faccioli, Lúcia H.},
  date = {2016-02-23},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {7},
  number = {1},
  pages = {10760},
  issn = {2041-1723},
  doi = {10.1038/ncomms10760},
  url = {https://www.nature.com/articles/ncomms10760},
  urldate = {2026-05-22},
  abstract = {Abstract                            Tityus serrulatus               sting causes thousands of deaths annually worldwide.               T. serrulatus               -envenomed victims exhibit local or systemic reaction that culminates in pulmonary oedema, potentially leading to death. However, the molecular mechanisms underlying               T. serrulatus               venom (TsV) activity remain unknown. Here we show that TsV triggers NLRP3 inflammasome activation via K               +               efflux. Mechanistically, TsV triggers lung-resident cells to release PGE               2               , which induces IL-1β production via E prostanoid receptor 2/4-cAMP-PKA-NFκB-dependent mechanisms. IL-1β/IL-1R actions account for oedema and neutrophil recruitment to the lungs, leading to TsV-induced mortality. Inflammasome activation triggers LTB               4               production and further PGE               2               via IL-1β/IL-1R signalling. Activation of LTB               4               -BLT1/2 pathway decreases cAMP generation, controlling TsV-induced inflammation. Exogenous administration confirms LTB               4               anti-inflammatory activity and abrogates TsV-induced mortality. These results suggest that the balance between LTB               4               and PGE               2               determines the amount of IL-1β inflammasome-dependent release and the outcome of envenomation. We suggest COX1/2 inhibition as an effective therapeutic intervention for scorpion envenomation.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\SX26MMK7\Zoccal et al. - 2016 - Opposing roles of LTB4 and PGE2 in regulating the inflammasome-dependent scorpion venom-induced mort.pdf}
}

@article{zollinoDiagnosisManagementPittHopkins2019,
  title = {Diagnosis and Management in {{Pitt}}‐{{Hopkins}} Syndrome: {{First}} International Consensus Statement},
  shorttitle = {Diagnosis and Management in {{Pitt}}‐{{Hopkins}} Syndrome},
  author = {Zollino, Marcella and Zweier, Christiane and Van Balkom, Ingrid D. and Sweetser, David A. and Alaimo, Joseph and Bijlsma, Emilia K. and Cody, Jannine and Elsea, Sarah H. and Giurgea, Irina and Macchiaiolo, Marina and Smigiel, Robert and Thibert, Ronald L. and Benoist, Ingrid and Clayton‐Smith, Jill and De Winter, Channa F. and Deckers, Stijn and Gandhi, Anusha and Huisman, Sylvia and Kempink, Dagmar and Kruisinga, Frea and Lamacchia, Vittoria and Marangi, Giuseppe and Menke, Leonie and Mulder, Paul and Nordgren, Ann and Renieri, Alessandra and Routledge, Sue and Saunders, Carol J. and Stembalska, Agnieszka and Van Balkom, Hans and Whalen, Sandra and Hennekam, Raoul C.},
  date = {2019-04},
  journaltitle = {Clinical Genetics},
  shortjournal = {Clinical Genetics},
  volume = {95},
  number = {4},
  pages = {462--478},
  issn = {0009-9163, 1399-0004},
  doi = {10.1111/cge.13506},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cge.13506},
  urldate = {2026-05-22},
  abstract = {Pitt‐Hopkins syndrome (PTHS) is a neurodevelopmental disorder characterized by intellectual disability, specific facial features, and marked autonomic nervous system dysfunction, especially with disturbances of regulating respiration and intestinal mobility. It is caused by variants in the transcription factor               TCF4               . Heterogeneity in the clinical and molecular diagnostic criteria and care practices has prompted a group of international experts to establish guidelines for diagnostics and care. For issues, for which there was limited information available in international literature, we collaborated with national support groups and the participants of a syndrome specific international conference to obtain further information. Here, we discuss the resultant consensus, including the clinical definition of PTHS and a molecular diagnostic pathway. Recommendations for managing particular health problems such as dysregulated respiration are provided. We emphasize the need for integration of care for physical and behavioral issues. The recommendations as presented here will need to be evaluated for improvements to allow for continued optimization of diagnostics and care.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\LCCLT3RG\Zollino et al. - 2019 - Diagnosis and management in Pitt‐Hopkins syndrome First international consensus statement.pdf}
}

