  title = {E3 {{Ubiquitin Ligase TRIP12}}: {{Regulation}}, {{Structure}}, and {{Physiopathological Functions}}},
  shorttitle = {E3 {{Ubiquitin Ligase TRIP12}}},
  author = {Brunet, Manon and Vargas, Claire and Larrieu, Dorian and Torrisani, Jérôme and Dufresne, Marlène},
  date = {2020-11-12},
  journaltitle = {International Journal of Molecular Sciences},
  shortjournal = {IJMS},
  volume = {21},
