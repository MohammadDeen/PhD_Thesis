@article{saekiEfficacySafetyOpenlabel2015,
  title = {Efficacy and Safety of Open‐label Ixekizumab Treatment in {{Japanese}} Patients with Moderate‐to‐severe Plaque Psoriasis, Erythrodermic Psoriasis and Generalized Pustular Psoriasis},
