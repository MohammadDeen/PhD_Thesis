@article{wilsmann-theisSuccessfulTreatmentInterleukin17A2018,
  title = {Successful Treatment with interleukin‐{{17A}} Antagonists of Generalized Pustular Psoriasis in Patients without {{{\mkbibemph{IL36RN}}}} Mutations},
