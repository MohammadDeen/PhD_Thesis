@article{waltersMAP1BMutationsCause2018,
  title = {{{MAP1B}} Mutations Cause Intellectual Disability and Extensive White Matter Deficit},
  author = {Walters, G. Bragi and Gustafsson, Omar and Sveinbjornsson, Gardar and Eiriksdottir, Valgerdur K. and Agustsdottir, Arna B. and Jonsdottir, Gudrun A. and Steinberg, Stacy and Gunnarsson, Arni F. and Magnusson, Magnus I. and Unnsteinsdottir, Unnur and Lee, Amy L. and Jonasdottir, Adalbjorg and Sigurdsson, Asgeir and Jonasdottir, Aslaug and Skuladottir, Astros and Jonsson, Lina and Nawaz, Muhammad S. and Sulem, Patrick and Frigge, Mike and Ingason, Andres and Love, Askell and Norddhal, Gudmundur L. and Zervas, Mark and Gudbjartsson, Daniel F. and Ulfarsson, Magnus O. and Saemundsen, Evald and Stefansson, Hreinn and Stefansson, Kari},
  date = {2018-08-27},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {9},
  number = {1},
  pages = {3456},
  issn = {2041-1723},
  doi = {10.1038/s41467-018-05595-6},
  url = {https://www.nature.com/articles/s41467-018-05595-6},
  urldate = {2026-05-22},
  abstract = {Abstract                            Discovery of coding variants in genes that confer risk of neurodevelopmental disorders is an important step towards understanding the pathophysiology of these disorders. Whole-genome sequencing of 31,463 Icelanders uncovers a frameshift variant (E712KfsTer10) in               microtubule-associated protein 1B               (               MAP1B               ) that associates with ID/low IQ in a large pedigree (genome-wide corrected               P               \,=\,0.022). Additional stop-gain variants in               MAP1B               (E1032Ter and R1664Ter) validate the association with ID and IQ. Carriers have 24\% less white matter (WM) volume (               β               \,=\,−2.1SD,               P               \,=\,5.1\,×\,10               −8               ), 47\% less corpus callosum (CC) volume (               β               \,=\,−2.4SD,               P               \,=\,5.5\,×\,10               −10               ) and lower brain-wide fractional anisotropy (               P               \,=\,6.7\,×\,10               −4               ). In summary, we show that loss of MAP1B function affects general cognitive ability through a profound, brain-wide WM deficit with likely disordered or compromised axons.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\NDRP6CDV\Walters et al. - 2018 - MAP1B mutations cause intellectual disability and extensive white matter deficit.pdf}
}

@article{wanCopyNumberAnalysis2022,
  title = {Copy {{Number Analysis}} in a {{Large Cohort Suggestive}} of {{Inborn Errors}} of {{Immunity Indicates}} a {{Wide Spectrum}} of {{Relevant Chromosomal Losses}} and {{Gains}}},
  author = {Wan, Rensheng and Schieck, Maximilian and Caballero-Oteyza, Andrés and Hofmann, Winfried and Cochino, Alexis Virgil and Shcherbina, Anna and Sherkat, Roya and Wache-Mainier, Clarisse and Fernandez, Anita and Sultan, Marc and Illig, Thomas and Grimbacher, Bodo and Proietti, Michele and Steinemann, Doris},
  date = {2022-07},
  journaltitle = {Journal of Clinical Immunology},
  shortjournal = {J Clin Immunol},
  volume = {42},
  number = {5},
  pages = {1083--1092},
  issn = {0271-9142, 1573-2592},
  doi = {10.1007/s10875-022-01276-8},
  url = {https://link.springer.com/10.1007/s10875-022-01276-8},
  urldate = {2026-05-22},
  abstract = {Abstract                            Inborn errors of immunity (IEI) are genetically driven disorders. With the advancement of sequencing technologies, a rapidly increasing number of gene defects has been identified, thereby mirroring the high heterogeneity in immunological and clinical presentations observed in patients. However, for a large majority of patients, no causative single nucleotide variant (SNV) or small indel can be identified using next-generation sequencing. First studies have shown that also copy number variants (CNVs) can cause IEI. Unfortunately, CNVs are not well examined in many routine diagnostic settings and the aim of this study was to assess the number of clinically relevant chromosomal losses and gains in a large cohort. We identified a total of 20 CNVs using whole exome sequencing data of a cohort of 191 patients with a suspected IEI. A definite molecular diagnosis could be made in five patients (2.6\%), including pathogenic deletions affecting               ICOS               ,               TNFAIP3               , and 22q11.2. CNVs of uncertain significance were observed in fifteen patients (7.9\%), including deletions of 11q22.1q22.3 and 16p11.2 but also duplications affecting entire or parts of genes previously associated with IEI. Importantly, five patients carrying a CNV of uncertain significance also carried pathogenic or likely pathogenic SNVs (               PIK3R1               ,               NFKB1               ,               NLRC4               ,               DOCK2               ), or SNVs of unknown significance (               NFKB2               ). This cooccurrence of SNVs and CNVs suggests modifying effects in some patients, and functional follow-up is warranted now in order to better understand phenotypic heterogeneity. In summary, the diagnostic yield of IEI can be increased substantially by evaluating CNVs, which allows an improved therapeutic management in those patients.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\P3269V3R\Wan et al. - 2022 - Copy Number Analysis in a Large Cohort Suggestive of Inborn Errors of Immunity Indicates a Wide Spec.pdf}
}

