  author = {Prochorec-Sobieszek, Monika and Rymkiewicz, Grzegorz and Makuch-Łasica, Hanna and Majewski, Mirosław and Michalak, Katarzyna and Rupiński, Robert and Warzocha, Krzysztof and Maryniak, Renata},
  date = {2008-05-12},
  journaltitle = {Arthritis Research \& Therapy},
