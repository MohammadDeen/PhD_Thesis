@article{brownTLR7GainoffunctionGenetic2022,
  title = {{{TLR7}} Gain-of-Function Genetic Variation Causes Human Lupus},
  author = {Brown, Grant J. and Cañete, Pablo F. and Wang, Hao and Medhavy, Arti and Bones, Josiah and Roco, Jonathan A. and He, Yuke and Qin, Yuting and Cappello, Jean and Ellyard, Julia I. and Bassett, Katharine and Shen, Qian and Burgio, Gaetan and Zhang, Yaoyuan and Turnbull, Cynthia and Meng, Xiangpeng and Wu, Phil and Cho, Eun and Miosge, Lisa A. and Andrews, T. Daniel and Field, Matt A. and Tvorogov, Denis and Lopez, Angel F. and Babon, Jeffrey J. and López, Cristina Aparicio and Gónzalez-Murillo, África and Garulo, Daniel Clemente and Pascual, Virginia and Levy, Tess and Mallack, Eric J. and Calame, Daniel G. and Lotze, Timothy and Lupski, James R. and Ding, Huihua and Ullah, Tomalika R. and Walters, Giles D. and Koina, Mark E. and Cook, Matthew C. and Shen, Nan and De Lucas Collantes, Carmen and Corry, Ben and Gantier, Michael P. and Athanasopoulos, Vicki and Vinuesa, Carola G.},
  date = {2022-05-12},
  journaltitle = {Nature},
  shortjournal = {Nature},
  volume = {605},
  number = {7909},
  pages = {349--356},
  issn = {0028-0836, 1476-4687},
  doi = {10.1038/s41586-022-04642-z},
  url = {https://www.nature.com/articles/s41586-022-04642-z},
  urldate = {2026-05-22},
  abstract = {Abstract                            Although circumstantial evidence supports enhanced Toll-like receptor 7~(TLR7) signalling as a mechanism of human systemic autoimmune disease               1–7               , evidence of lupus-causing               TLR7               gene variants is lacking. Here we describe human systemic lupus erythematosus caused by a               TLR7               gain-of-function variant. TLR7 is a sensor of viral RNA               8               ,               9               and binds to guanosine               10               –               12               .~We identified a de novo, previously undescribed missense               TLR7                                Y264H                              variant in a child with severe lupus and additional variants in other patients with lupus. The               TLR7                                Y264H                              variant selectively increased sensing of guanosine and 2',3'-cGMP               10–12               , and was sufficient to cause lupus when introduced into mice. We show that enhanced TLR7 signalling drives aberrant survival of B cell receptor (BCR)-activated B cells, and~in a cell-intrinsic manner, accumulation of CD11c               +               age-associated B cells and germinal centre B cells. Follicular and extrafollicular helper T cells were also increased but these phenotypes were cell-extrinsic. Deficiency of MyD88~(an adaptor protein downstream of TLR7) rescued autoimmunity, aberrant B cell survival, and all cellular and serological phenotypes. Despite prominent spontaneous germinal-centre formation in               Tlr7                                Y264H                              mice, autoimmunity was not ameliorated by germinal-centre deficiency, suggesting an extrafollicular origin of pathogenic B cells. We establish the importance of TLR7 and guanosine-containing self-ligands for human lupus pathogenesis, which paves the way for therapeutic TLR7 or MyD88 inhibition.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\UR789X88\Brown et al. - 2022 - TLR7 gain-of-function genetic variation causes human lupus.pdf}
}

