@article{garshickActivatedPlateletsInduce2020,
  title = {Activated {{Platelets Induce Endothelial Cell Inflammatory Response}} in {{Psoriasis}} via {{COX-1}}},
  author = {Garshick, Michael S. and Tawil, Michael and Barrett, Tessa J. and Salud-Gnilo, Charissa M. and Eppler, Michael and Lee, Angela and Scher, Jose U. and Neimann, Andrea L. and Jelic, Sanja and Mehta, Nehal N. and Fisher, Edward A. and Krueger, James G. and Berger, Jeffrey S.},
  date = {2020-05},
  journaltitle = {Arteriosclerosis, Thrombosis, and Vascular Biology},
  shortjournal = {ATVB},
  volume = {40},
  number = {5},
  pages = {1340--1351},
  issn = {1079-5642, 1524-4636},
  doi = {10.1161/ATVBAHA.119.314008},
  url = {https://www.ahajournals.org/doi/10.1161/ATVBAHA.119.314008},
  urldate = {2026-05-22},
  abstract = {Objective:               Patients with psoriasis have impaired vascular health and increased cardiovascular disease (CVD). Platelets are key players in the pathogenesis of vascular dysfunction in cardiovascular disease and represent therapeutic targets in cardiovascular prevention. The object of this study was to define the platelet phenotype and effector cell properties on vascular health in psoriasis and evaluate whether aspirin modulates the platelet-induced phenotype.                                         Approach and Results:                                Platelets from psoriasis patients (n=45) exhibited increased platelet activation (relative to age- and gender-matched controls, n=18), which correlated with psoriasis skin severity. Isolated platelets from psoriasis patients demonstrated a 2- to 3-fold (                 P                 {$<$}0.01) increased adhesion to human aortic endothelial cells and induced proinflammatory transcriptional changes, including upregulation of                 IL 8                 (interleukin 8),                 IL1β                 , and Cox (cyclooxygenase)-2 Platelet RNA sequencing revealed an interferon signature and elevated expression of                 COX-1                 , which correlated with psoriasis disease severity (                 r                 =0.83,                 P                 =0.01). In a randomized trial of patients with psoriasis, 2 weeks of 81 mg low-dose aspirin, a COX-1 inhibitor, reduced serum thromboxane (Tx) B                 2                 and reduced brachial vein endothelial proinflammatory transcript expression {$>$}70\% compared with the no-treatment group (                 P                 {$<$}0.01). Improvement in brachial vein endothelial cell inflammation significantly correlated with change in serum TxB                 2                 (                 r                 =0.48,                 P                 =0.02).                                                        Conclusions:               In patients with psoriasis, platelets are activated and induce endothelial cell inflammation. Low-dose aspirin improved endothelial cell health in psoriasis via platelet COX-1 inhibition. These data demonstrate a previously unappreciated role of platelets in psoriasis and endothelial cell inflammation and suggests that aspirin may be effective in improving vascular health in patients with psoriasis.                                         Registration:                                URL:                 http://www.clinicaltrials.gov                 . Unique identifier: NCT03228017.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\7U4PRJXQ\Garshick et al. - 2020 - Activated Platelets Induce Endothelial Cell Inflammatory Response in Psoriasis via COX-1.pdf}
}

