@article{kiyosawaSystematicGenomewideApproach2004,
  title = {Systematic Genome‐wide Approach to Positional Candidate Cloning for Identification of Novel Human Disease Genes},
  author = {Kiyosawa, H. and Kawashima, T. and Silva, D. and Petrovsky, N. and Hasegawa, Y. and Sakai, K. and Hayashizaki, Y.},
  date = {2004-03},
