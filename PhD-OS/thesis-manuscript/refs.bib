@article{blumbergIL1RL2ItsLigands2010,
  title = {{{IL-1RL2}} and {{Its Ligands Contribute}} to the {{Cytokine Network}} in {{Psoriasis}}},
  author = {Blumberg, Hal and Dinh, Huyen and Dean, Charles and Trueblood, Esther S and Bailey, Keith and Shows, Donna and Bhagavathula, Narasimharao and Aslam, Muhammad Nadeem and Varani, James and Towne, Jennifer E and Sims, John E},
  date = {2010-10-01},
  journaltitle = {The Journal of Immunology},
  volume = {185},
  number = {7},
  pages = {4354--4362},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1000313},
  url = {https://academic.oup.com/jimmunol/article/185/7/4354/7984732},
  urldate = {2026-05-22},
  abstract = {Abstract             Psoriasis is a common immune-mediated disease in European populations; it is characterized by inflammation and altered epidermal differentiation leading to redness and scaling. T cells are thought to be the main driver, but there is also evidence for an epidermal contribution. In this article, we show that treatment of mouse skin overexpressing the IL-1 family member, IL-1F6, with phorbol ester leads to an inflammatory condition with macroscopic and histological similarities to human psoriasis. Inflammatory cytokines thought to be important in psoriasis, such as TNF-α, IL-17A, and IL-23, are upregulated in the mouse skin. These cytokines are induced by and can induce IL-1F6 and related IL-1 family cytokines. Inhibition of TNF or IL-23 inhibits the increased epidermal thickness, inflammation, and cytokine production. Blockade of IL-1F6 receptor also resolves the inflammatory changes in human psoriatic lesional skin transplanted onto immunodeficient mice. These data suggest a role for IL-1F family members in psoriasis.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\TF3696GD\Blumberg et al. - 2010 - IL-1RL2 and Its Ligands Contribute to the Cytokine Network in Psoriasis.pdf}
}

@article{blumbergOpposingActivitiesTwo2007,
  title = {Opposing Activities of Two Novel Members of the {{IL-1}} Ligand Family Regulate Skin Inflammation},
  author = {Blumberg, Hal and Dinh, Huyen and Trueblood, Esther S. and Pretorius, James and Kugler, David and Weng, Ning and Kanaly, Suzanne T. and Towne, Jennifer E. and Willis, Cynthia R. and Kuechle, Melanie K. and Sims, John E. and Peschon, Jacques J.},
  date = {2007-10-29},
  journaltitle = {The Journal of Experimental Medicine},
  volume = {204},
  number = {11},
  pages = {2603--2614},
  issn = {1540-9538, 0022-1007},
  doi = {10.1084/jem.20070157},
  url = {https://rupress.org/jem/article/204/11/2603/46546/Opposing-activities-of-two-novel-members-of-the-IL},
  urldate = {2026-05-22},
  abstract = {The interleukin (IL)-1 family members IL-1α, -1β, and -18 are potent inflammatory cytokines whose activities are dependent on heterodimeric receptors of the IL-1R superfamily, and which are regulated by soluble antagonists. Recently, several new IL-1 family members have been identified. To determine the role of one of these family members in the skin, transgenic mice expressing IL1F6 in basal keratinocytes were generated. IL1F6 transgenic mice exhibit skin abnormalities that are dependent on IL-1Rrp2 and IL-1RAcP, which are two members of the IL-1R family. The skin phenotype is characterized by acanthosis, hyperkeratosis, the presence of a mixed inflammatory cell infiltrate, and increased cytokine and chemokine expression. Strikingly, the combination of the IL-1F6 transgene with an IL1F5 deficiency results in exacerbation of the skin phenotype, demonstrating that IL-1F5 has antagonistic activity in vivo. Skin from IL1F6 transgenic, IL1F5−/− pups contains intracorneal and intraepithelial pustules, nucleated corneocytes, and dilated superficial dermal blood vessels. Additionally, expression of IL1RL2, -1F5, and -1F6 is increased in human psoriatic skin. In summary, dysregulated expression of novel agonistic and antagonistic IL-1 family member ligands can promote cutaneous inflammation, revealing potential novel targets for the treatment of inflammatory skin disorders.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\BXBPC5M3\Blumberg et al. - 2007 - Opposing activities of two novel members of the IL-1 ligand family regulate skin inflammation.pdf}
}

