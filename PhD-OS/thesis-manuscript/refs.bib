@article{gouletEProstanoid3ReceptorsMediate2004,
  title = {E-{{Prostanoid-3 Receptors Mediate}} the {{Proinflammatory Actions}} of {{Prostaglandin E2}} in {{Acute Cutaneous Inflammation}}},
