@article{hircheMyeloperoxidasePlaysCritical2005,
  title = {Myeloperoxidase {{Plays Critical Roles}} in {{Killing}} {{{\mkbibemph{Klebsiella}}}}{\mkbibemph{ Pneumoniae}} and {{Inactivating Neutrophil Elastase}}: {{Effects}} on {{Host Defense}}},
  shorttitle = {Myeloperoxidase {{Plays Critical Roles}} in {{Killing}} {{{\mkbibemph{Klebsiella}}}}{\mkbibemph{ Pneumoniae}} and {{Inactivating Neutrophil Elastase}}},
  author = {Hirche, Tim O and Gaut, Joseph P and Heinecke, Jay W and Belaaouaj, Azzaq},
  date = {2005-02-01},
  journaltitle = {The Journal of Immunology},
  volume = {174},
  number = {3},
  pages = {1557--1565},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.174.3.1557},
  url = {https://academic.oup.com/jimmunol/article/174/3/1557/8036680},
  urldate = {2026-05-22},
  abstract = {Abstract             Activated neutrophils use myeloperoxidase (MPO) to generate an array of potent toxic oxidants. In the current studies we used genetically altered mice deficient in MPO to investigate the role of the enzyme in host defense against the Gram-negative bacterium Klebsiella pneumoniae, an important human pathogen. For comparison, we used mice deficient in the antimicrobial molecule, neutrophil elastase (NE). When challenged i.p., mice deficient in either MPO or NE were markedly more susceptible to bacterial infection and death. In vitro studies suggested that MPO impairs the morphology of bacteria in a distinctive way. Of importance, our in vitro studies found that MPO mediated oxidative inactivation of NE, an enzyme that has been widely implicated in the pathogenesis of various tissue-destructive diseases. This pathway of oxidative inactivation may be physiologically relevant, because activated neutrophils isolated from MPO-deficient mice exhibited increased elastase activity. Our observations provide strong evidence that MPO, like NE, is a key player in the killing of K. pneumoniae bacteria. They also suggest that MPO may modulate NE to protect the host from the tissue-degrading activity of this proteinase.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\STKGAX6S\Hirche et al. - 2005 - Myeloperoxidase Plays Critical Roles in Killing Klebsiella pneumoniae and Inactivating Neutro.pdf}
}

@article{hiroseInhibitionStabilin2Elevates2012,
  title = {Inhibition of {{Stabilin-2}} Elevates Circulating Hyaluronic Acid Levels and Prevents Tumor Metastasis},
  author = {Hirose, Yoshikazu and Saijou, Eiko and Sugano, Yasuyoshi and Takeshita, Fumitaka and Nishimura, Satoshi and Nonaka, Hidenori and Chen, Yen-Rong and Sekine, Keisuke and Kido, Taketomo and Nakamura, Takashi and Kato, Shigeaki and Kanke, Toru and Nakamura, Koji and Nagai, Ryozo and Ochiya, Takahiro and Miyajima, Atsushi},
  date = {2012-03-13},
  journaltitle = {Proceedings of the National Academy of Sciences},
  shortjournal = {Proc. Natl. Acad. Sci. U.S.A.},
  volume = {109},
  number = {11},
  pages = {4263--4268},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.1117560109},
  url = {https://pnas.org/doi/full/10.1073/pnas.1117560109},
  urldate = {2026-05-22},
  abstract = {Hyaluronic acid (HA) has been implicated in the proliferation and metastasis of tumor cells. However, most previous studies were conducted on extracellular matrix or pericellular HA, and the role of circulating HA in vivo has not been studied. HA is rapidly cleared from the bloodstream. The scavenger receptor Stabilin-2 (Stab2) is considered a major clearance receptor for HA. Here we report a dramatic elevation in circulating HA levels in Stab2-deficient mice without any overt phenotype. Surprisingly, the metastasis of B16F10 melanoma cells to the lungs was markedly suppressed in the Stab2-deficient mice, whereas cell proliferation was not affected. Furthermore, administration of an anti-Stab2 antibody in Stab2               +               mice elevated serum HA levels and prevented the metastasis of melanoma to the lung, and also suppressed spontaneous metastasis of mammary tumor and human breast tumor cells inoculated in the mammary gland. Administration of the antibody or high-dose HA in mice blocked the lodging of melanoma cells to the lungs. Furthermore, HA at high concentrations inhibited the rolling/tethering of B16 cells to lung endothelial cells. These results suggest that blocking Stab2 function prevents tumor metastasis by elevating circulating HA levels. Stab2 may be a potential target in antitumor therapy.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\DXCZ3A6E\Hirose et al. - 2012 - Inhibition of Stabilin-2 elevates circulating hyaluronic acid levels and prevents tumor metastasis.pdf}
}

