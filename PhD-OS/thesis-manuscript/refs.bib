@article{chapmanFibulin2Fibulin5Cooperatively2010,
  title = {Fibulin-2 and {{Fibulin-5 Cooperatively Function}} to {{Form}} the {{Internal Elastic Lamina}} and {{Protect From Vascular Injury}}},
  author = {Chapman, Shelby L. and Sicot, F.-X. and Davis, Elaine C. and Huang, Jianbin and Sasaki, Takako and Chu, Mon-Li and Yanagisawa, Hiromi},
  date = {2010-01},
  journaltitle = {Arteriosclerosis, Thrombosis, and Vascular Biology},
  shortjournal = {ATVB},
  volume = {30},
  number = {1},
  pages = {68--74},
  issn = {1079-5642, 1524-4636},
  doi = {10.1161/ATVBAHA.109.196725},
  url = {https://www.ahajournals.org/doi/10.1161/ATVBAHA.109.196725},
  urldate = {2026-05-22},
  abstract = {Objective—                              Recent findings on the role of fibulin-5 (Fbln5) have provided substantial progress in understanding the molecular mechanism of elastic fiber assembly in vitro. However, little is known about differential roles of fibulins in the elastogenesis of blood vessels. Here, we generated double knockout mice for               Fbln5               and               Fbln2               (termed               DKO               ) and examined the role of fibulins-2 and -5 in development and injury response of the blood vessel wall.                                                          Methods and Results—                              Fibulin-2 is distinctly located in the subendothelial matrix, whereas fibulin-5 is observed throughout the vessel wall. All of the elastic laminae, including the internal elastic lamina (IEL), were severely disorganized in               DKO               mice, which was not observed in single knockout mice for               Fbln2               or               Fbln5               . Furthermore,               DKO               vessels displayed upregulation of vascular adhesion molecules, tissue factor expression, and thrombus formation with marked dilation and thinning of the vessel wall after carotid artery ligation-injury.                                                          Conclusions—                              Fibulin-2 and fibulin-5 cooperatively function to form the IEL during postnatal development by directing the assembly of elastic fibers, and are responsible for maintenance of the adult vessel wall after injury. The               DKO               mouse will serve as a unique animal model to test the effect of vessel integrity during various pathological insults.                        ,              To investigate the molecular mechanism of development of the IEL, we generated a mouse strain that exhibited disrupted elastic laminae throughout the blood vessel wall by deleting fibulin-2 and fibulin-5. We further showed that the IEL protects against abnormal remodeling of the vessel wall and thrombus formation in injured vessels.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\FE43FNPU\Chapman et al. - 2010 - Fibulin-2 and Fibulin-5 Cooperatively Function to Form the Internal Elastic Lamina and Protect From.pdf}
}

@article{charbit-henrionSystemicInflammatorySyndrome2022,
  title = {Systemic Inflammatory Syndrome in Children with {\textsc{ }}{{{\textsc{{\mkbibemph{FARSA}}}}}}{\textsc{ }} Deficiency},
  shorttitle = {Systemic Inflammatory Syndrome in Children With},
  author = {Charbit‐Henrion, Fabienne and Goguyer‐Deschaumes, Roman and Borensztajn, Keren and Mirande, Marc and Berthelet, Jérémy and Rodrigues‐Lima, Fernando and Khiat, Anis and Frémond, Marie‐Louise and Bader‐Meunier, Brigitte and Rodari, Marco M. and Seabra, Luis and Rice, Gillian I. and Legendre, Marie and Drummond, David and Berteloot, Laureline and Roux, Charles‐Joris and Boddaert, Nathalie and Drabent, Philippe and Molina, Thierry Jo and Lacaille, Florence and Kossorotoff, Manoelle and Cerf‐Bensussan, Nadine and Parlato, Marianna and Hadchouel, Alice},
  date = {2022-05},
  journaltitle = {Clinical Genetics},
  shortjournal = {Clinical Genetics},
  volume = {101},
  number = {5--6},
  pages = {552--558},
  issn = {0009-9163, 1399-0004},
  doi = {10.1111/cge.14120},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cge.14120},
  urldate = {2026-05-22},
  abstract = {Abstract                            Variants in aminoacyl‐tRNA synthetases (ARSs) genes are associated to a broad spectrum of human inherited diseases. Patients with defective PheRS, encoded by               FARSA               and               FARSB               , display brain abnormalities, interstitial lung disease and facial dysmorphism. We investigated four children from two unrelated consanguineous families carrying two missense homozygous variants in               FARSA               with significantly reduced PheRS‐mediated aminoacylation activity. In addition to the core ARS‐phenotype, all patients showed an inflammatory profile associated with autoimmunity and interferon score, a clinical feature not ascribed to PheRS‐deficient patients to date. JAK inhibition improved lung disease in one patient. Our findings expand the genetic and clinical spectrum of FARSA‐related disease.},
  langid = {english},
