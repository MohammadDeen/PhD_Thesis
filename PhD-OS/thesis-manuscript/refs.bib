  url = {https://portlandpress.com/biochemsoctrans/article/46/2/311/67280/Nesprin-1-2-roles-in-nuclear-envelope-organisation},
  urldate = {2026-05-22},
  abstract = {Nesprins (nuclear envelope spectrin repeat proteins) are multi-isomeric scaffolding proteins. Nesprin-1 and -2 are highly expressed in skeletal and cardiac muscles and together with SUN (Sad1p/UNC84) domain-containing proteins form the LInker of Nucleoskeleton and Cytoskeleton (LINC) complex at the nuclear envelope in association with lamin A/C and emerin. Mutations in nesprin-1/2 have been found in patients with autosomal dominant Emery–Dreifuss muscular dystrophy (EDMD) as well as dilated cardiomyopathy (DCM). Several lines of evidence indicate that compromised LINC complex function is the critical step leading to muscle disease. Here, we review recent advances in our understanding of the functions of nesprin-1/2 in the LINC complex and mechanistic insights into how mutations in nesprin-1/2 lead to nesprin-related muscle diseases, in particular DCM and EDMD.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\87NRLEAT\Zhou et al. - 2018 - Nesprin-12 roles in nuclear envelope organisation, myogenesis and muscle disease.pdf}
}

