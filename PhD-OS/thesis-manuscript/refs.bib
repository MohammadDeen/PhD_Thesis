@article{parkNovelHIVEP2Variants2019,
  title = {Novel {{HIVEP2 Variants}} in {{Patients}} with {{Intellectual Disability}}},
  author = {Park, Joohyun and Colombo, Roberto and Schäferhoff, Karin and Janiri, Luigi and Grimmel, Mona and Sturm, Marc and Grasshoff, Ute and Dufke, Andreas and Haack, Tobias B. and Kehrer, Martin},
