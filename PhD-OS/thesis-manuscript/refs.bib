  author = {Guo, Bi-Rong and Zhang, Xin and Chen, Gang and Zhang, Jian-Guo and Sun, Liang-Dan and Du, Wei-dong and Zhang, Qing and Cui, Yong and Zhu, Jun and Tang, Xian-Fa and Xiao, Ruo and Liu, Yuan and Li, Min and Tang, Hua-Yang and Yang, Xu and Cheng, Hui and Li, Ming and Gao, Min and Li, Ping and Wang, Jian-Bo and Xu, Feng-Ping and Zuo, Xian-Bo and Zheng, Xiao-Dong and Zhang, Xiao-Guang and Yang, Lin and Liu, Jian-Jun and Wang, Jun and Yang, Sen and Zhang, Xue-Jun},
  date = {2012-09},
  journaltitle = {Journal of Medical Genetics},
  shortjournal = {J Med Genet},
  volume = {49},
  number = {9},
  pages = {563--568},
  issn = {0022-2593, 1468-6244},
  doi = {10.1136/jmedgenet-2012-100868},
  url = {https://jmg.bmj.com/lookup/doi/10.1136/jmedgenet-2012-100868},
  urldate = {2026-05-22},
  abstract = {Background               Punctate palmoplantar keratoderma (PPPK) is a rare autosomal dominant skin disorder characterised by numerous hyperkeratotic papules irregularly distributed on the palms and soles. To date, no causal gene for this disease has been identified.                                         Methods               We performed exome sequencing analysis of four affected individuals and two unaffected controls from one Chinese PPPK family where disease locus was mapped at 8q24.13-8q24.21 by our previous linkage analysis.                                         Results                                We identified a novel heterozygous mutation in                 COL14A1                 gene (c.4505C→T (p.Pro1502Leu)), which located within the linkage region that we previously identified for PPPK. The mutation was shared by the four affected individuals, but not for the two controls of the family. Sanger sequencing confirmed this mutation in another four cases from this family. This mutation was invisible in the normal controls of this family as well as the additional 676 unrelated normal controls and 781 patients with other disease. The shared                 COL14A1                 mutation, p.Pro1502Leu, is a missense substitution at a highly conserved amino acid residue across multiple species.                                                        Conclusions                                The power of combining exome sequencing and linkage information in the study of genetics of autosomal dominant disorders, even in simplex cases, has been demonstrated. Our results suggested that                 COL14A1                 would be a casual gene for PPPK, which was helpful for advancing us on understanding of the pathogenesis of PPPK.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\J64HHSFB\Guo et al. - 2012 - Exome sequencing identifies a COL14A1 mutation in a large Chinese pedigree with punctate palm.pdf}
}

