@article{fejtkovaTLR8TLR7Dysregulation2022,
  title = {{{{\textsc{TLR8}}}} / {{{\textsc{TLR7}}}} Dysregulation Due to a Novel {{{\mkbibemph{TLR8}}}} Mutation Causes Severe Autoimmune Hemolytic Anemia and Autoinflammation in Identical Twins},
  author = {Fejtkova, Martina and Sukova, Martina and Hlozkova, Katerina and Skvarova Kramarzova, Karolina and Rackova, Marketa and Jakubec, David and Bakardjieva, Marina and Bloomfield, Marketa and Klocperk, Adam and Parackova, Zuzana and Sediva, Anna and Aluri, Jahnavi and Novakova, Michaela and Kalina, Tomas and Fronkova, Eva and Hrusak, Ondrej and Malcova, Hana and Sedlacek, Petr and Liba, Zuzana and Kudr, Martin and Stary, Jan and Cooper, Megan A. and Svaton, Michael and Kanderova, Veronika},
  date = {2022-03},
  journaltitle = {American Journal of Hematology},
  shortjournal = {American J Hematol},
  volume = {97},
  number = {3},
  pages = {338--351},
  issn = {0361-8609, 1096-8652},
  doi = {10.1002/ajh.26452},
  url = {https://onlinelibrary.wiley.com/doi/10.1002/ajh.26452},
  urldate = {2026-05-22},
  abstract = {Abstract                            Our study presents a novel germline c.1715G{$>$}T (p.G572V) mutation in the gene encoding Toll‐like receptor 8 (               TLR8               ) causing an autoimmune and autoinflammatory disorder in a family with monozygotic male twins, who suffer from severe autoimmune hemolytic anemia worsening with infections, and autoinflammation presenting as fevers, enteritis, arthritis, and CNS vasculitis. The pathogenicity of the mutation was confirmed by in vitro assays on transfected cell lines and primary cells. The p.G572V mutation causes impaired stability of the TLR8 protein, cross‐reactivity to TLR7 ligands and reduced ability of TLR8 to attenuate TLR7 signaling. This imbalance toward TLR7‐dependent signaling leads to increased pro‐inflammatory responses, such as nuclear factor‐κB (NF‐κB) activation and production of pro‐inflammatory cytokines IL‐1β, IL‐6, and TNFα. This unique               TLR8               mutation with partial TLR8 protein loss and hyperinflammatory phenotype mediated by TLR7 ligands represents a novel inborn error of immunity with childhood‐onset and a good response to TLR7 inhibition.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\QW5B54Y4\Fejtkova et al. - 2022 - TLR8  TLR7sp.pdf}
}

