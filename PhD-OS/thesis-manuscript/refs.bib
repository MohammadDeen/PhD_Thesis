@article{kainuAssociationPsoriasisPGLYRP2009,
  title = {Association of Psoriasis to {{PGLYRP}} and {{SPRR}} Genes at {{PSORS4}} Locus on 1q Shows Heterogeneity between {{Finnish}}, {{Swedish}} and {{Irish}} Families},
  author = {Kainu, Kati and Kivinen, Katja and Zucchelli, Marco and Suomela, Sari and Kere, Juha and Inerot, Annica and Baker, Barbara S. and Powles, Anne V. and Fry, Lionel and Samuelsson, Lena and Saarialho‐Kere, Ulpu},
