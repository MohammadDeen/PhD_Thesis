@article{donlinModulationTNFInducedMacrophage2014,
  title = {Modulation of {{TNF-Induced Macrophage Polarization}} by {{Synovial Fibroblasts}}},
  author = {Donlin, Laura T and Jayatilleke, Arundathi and Giannopoulou, Eugenia G and Kalliolias, George D and Ivashkiv, Lionel B},
  date = {2014-09-01},
  journaltitle = {The Journal of Immunology},
  volume = {193},
  number = {5},
  pages = {2373--2383},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1400486},
  url = {https://academic.oup.com/jimmunol/article/193/5/2373/7960641},
  urldate = {2026-05-22},
  abstract = {Abstract             Mesenchymal stromal cells have emerged as powerful modulators of the immune system. In this study, we explored how the human macrophage response to TNF is regulated by human synovial fibroblasts, the representative stromal cell type in the synovial lining of joints that become activated during inflammatory arthritis. We found that synovial fibroblasts strongly suppressed TNF-mediated induction of an IFN-β autocrine loop and downstream expression of IFN-stimulated genes (ISGs), including chemokines CXCL9 and CXCL10 that are characteristic of classical macrophage activation. TNF induced the production of soluble synovial fibroblast factors that suppressed the macrophage production of IFN-β, and cooperated with TNF to limit the responsiveness of macrophages to IFN-β by suppressing activation of Jak–STAT signaling. Genome-wide transcriptome analysis showed that cocultured synovial fibroblasts modulate the expression of approximately one third of TNF-regulated genes in macrophages, including genes in pathways important for macrophage survival and polarization toward an alternatively activated phenotype. Pathway analysis revealed that gene expression programs regulated by synovial fibroblasts in our coculture system were also regulated in rheumatoid arthritis synovial macrophages, suggesting that these fibroblast-mediated changes may contribute to rheumatoid arthritis pathogenesis. This work furthers our understanding of the interplay between innate immune and stromal cells during an inflammatory response, one that is particularly relevant to inflammatory arthritis. Our findings also identify modulation of macrophage phenotype as a new function for synovial fibroblasts that may prove to be a contributing factor in arthritis pathogenesis.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\UCMDAUPI\Donlin et al. - 2014 - Modulation of TNF-Induced Macrophage Polarization by Synovial Fibroblasts.pdf}
}

