@article{paulmannSchwereArzneimittelinduzierteHautreaktionen2015,
  title = {Schwere Arzneimittelinduzierte {{Hautreaktionen}}: {{Klinik}}, {{Diagnostik}}, {{Ätiologie}} Und {{Therapie}}},
  shorttitle = {Schwere Arzneimittelinduzierte {{Hautreaktionen}}},
  author = {Paulmann, Maren and Mockenhaupt, Maja},
  date = {2015-07},
  journaltitle = {JDDG: Journal der Deutschen Dermatologischen Gesellschaft},
  shortjournal = {J Deutsche Derma Gesell},
  volume = {13},
  number = {7},
  pages = {625--645},
  issn = {1610-0379, 1610-0387},
  doi = {10.1111/ddg.130_12747},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/ddg.130_12747},
  urldate = {2026-05-22},
  abstract = {Zusammenfassung             Arzneimittel können schwere Hautreaktionen auslösen, deren Reaktionsformen sich im klinischen Bild, in der Prognose und der Therapie unterscheiden. Neben Stevens‐Johnson‐Syndrom (SJS), toxisch epidermaler Nekrolyse (TEN) und generalisiertem bullösen fixen Arzneiexanthem (GBFDE) zählen auch die beiden nicht primär bullösen Reaktionen akute generalisierte exanthematische Pustulose (AGEP) und „drug reaction with eosinophilia and systemic symptoms“ (DRESS) zu den schweren arzneimittelinduzierten Hautreaktionen. Im ersten Schritt sollte mittels exakter klinischer Untersuchung, der Entnahme einer Probebiopsie sowie durch spezielle Laboruntersuchungen bei Verdacht auf AGEP oder DRESS eine Sicherung der Diagnose erfolgen. Des Weiteren sind die schnelle Identifizierung sowie das Absetzen des auslösenden Agens entscheidend für die Prognose des Patienten. Hierfür sollte man die häufigsten Auslöser der jeweiligen Reaktionsform kennen, wobei einige Medikamente unterschiedliche Reaktionsformen auslösen können. Je nach Diagnosefindung wird neben der symptomatischen und supportiven Wundversorgung, eine systemisch immunmodulierende Therapie angewendet. In Abhängigkeit von Alter und Grunderkrankungen sowie dem Ausmaß der Hautablösung ist die Prognose bei SJS/TEN oftmals ungünstig. Die Prognose bei GBFDE ist etwas besser, aber schwerer verlaufende Rezidive sind beschrieben. Bei DRESS können langwierige und rezidivierende Verläufe auftreten, während bei der AGEP eine meist problemlose Abheilung vorliegt.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\XAS6424J\Paulmann and Mockenhaupt - 2015 - Schwere arzneimittelinduzierte Hautreaktionen Klinik, Diagnostik, Ätiologie und Therapie.pdf}
}

