@article{kloypanComprehensiveReviewHLA2021,
  title = {A {{Comprehensive Review}} of {{HLA}} and {{Severe Cutaneous Adverse Drug Reactions}}: {{Implication}} for {{Clinical Pharmacogenomics}} and {{Precision Medicine}}},
