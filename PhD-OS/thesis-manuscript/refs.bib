  author = {family=Adamo, given=Adamo Pio, prefix=d’, useprefix=true and Bianco, Anna Monica and Ferrara, Giovanna and La Bianca, Martina and Insalaco, Antonella and Tommasini, Alberto and Pardeo, Manuela and Cattalini, Marco and La Torre, Francesco and Finetti, Martina and Alizzi, Clotilde and Simonini, Gabriele and Messia, Virginia and Pastore, Serena and Cimaz, Rolando and Gattorno, Marco and Taddio, Andrea and {for the Italian Pediatric Rheumatology Study Group}},
  date = {2020-12},
  journaltitle = {Pediatric Rheumatology},
  shortjournal = {Pediatr Rheumatol},
  volume = {18},
  number = {1},
  pages = {55},
  issn = {1546-0096},
  doi = {10.1186/s12969-020-00447-4},
  url = {https://ped-rheum.biomedcentral.com/articles/10.1186/s12969-020-00447-4},
  urldate = {2026-05-22},
  abstract = {Abstract                            Background                                FBLIM1                 gene has been recently demonstrated to be involved in the pathogenesis of bone sterile inflammation. The aim of the study is to evaluate the prevalence of                 FBLIM1                 gene variants in a cohort of 80 Italian patients with Chronic Non-bacterial Osteomyelitis (CNO).                                                        Methods                                The coding regions of                 FBLIM1                 gene were sequenced in a cohort of 80 patients with CNO using DNA extracted from blood lymphocytes, and PCR products were sequenced. Only rare (global MAF\,{$<$}\,2\%), coding variants detected were considered. Clinical evaluation of patients with rare variants and those without was performed. Fisher’s exact test was used to compare categorical and ordinal data, and Student’s t-test was used to analyze continuous data.                                                        Results                                Eighteen out of 80 patients (\textasciitilde\,22\%) presented at least one rare coding variant in                 FBLIM1                 . Eight patients presented a variant never associated before with CNO. All patients presented classical features of CNO and no statistical difference between patients with presence of                 FBLMI1                 variants and those without were found in terms of clinical manifestation, treatment, and outcome.                                                        Conclusion                                Considering the high frequency of rare variants in our CNO cohort, our data seem to confirm a possible role of                 FBLIM1                 in the pathogenesis of CNO suggesting that CNO is a disorder of chronic inflammation and imbalanced bone remodeling.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\45E9A9SC\d’Adamo et al. - 2020 - High prevalence of rare FBLIM1 gene variants in an Italian cohort of patients with Chronic Non-bacte.pdf}
}

@article{dahlqvistCongenitalIchthyosisMutations2007,
  title = {Congenital Ichthyosis: Mutations in {\mkbibemph{Ichthyin}} Are Associated with Specific Structural Abnormalities in the Granular Layer of Epidermis},
  shorttitle = {Congenital Ichthyosis},
  author = {Dahlqvist, J and Klar, J and Hausser, I and Anton-Lamprecht, I and Pigg, M Hellström and Gedde-Dahl, T and Gånemo, A and Vahlquist, A and Dahl, N},
  date = {2007-10},
  journaltitle = {Journal of Medical Genetics},
