@article{hechtJointDegenerationMouse2021,
  title = {Joint {{Degeneration}} in a {{Mouse Model}} of {{Pseudoachondroplasia}}: {{ER Stress}}, {{Inflammation}}, and {{Block}} of {{Autophagy}}},
  shorttitle = {Joint {{Degeneration}} in a {{Mouse Model}} of {{Pseudoachondroplasia}}},
  author = {Hecht, Jacqueline T. and Veerisetty, Alka C. and Hossain, Mohammad G. and Patra, Debabrata and Chiu, Frankie and Coustry, Francoise and Posey, Karen L.},
  date = {2021-08-26},
  journaltitle = {International Journal of Molecular Sciences},
