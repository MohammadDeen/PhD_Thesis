@article{tchernitchkoMEFVAnalysisParticularly2005,
  title = {{{{\mkbibemph{MEFV}}}} Analysis Is of Particularly Weak Diagnostic Value for Recurrent Fevers in {{Western European Caucasian}} Patients},
  author = {Tchernitchko, D. and Moutereau, S. and Legendre, M. and Delahaye, A. and Cazeneuve, C. and Lacombe, C. and Grateau, G. and Amselem, S.},
  date = {2005-11},
  journaltitle = {Arthritis \& Rheumatism},
