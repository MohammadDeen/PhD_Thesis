@article{ryzhakovIL17BoostsProinflammatory2011,
  title = {{{IL-17 Boosts Proinflammatory Outcome}} of {{Antiviral Response}} in {{Human Cells}}},
  author = {Ryzhakov, Grigory and Lai, Cheryl Chuk-ke and Blazek, Katrina and To, Ken-win and Hussell, Tracy and Udalova, Irina},
  date = {2011-11-15},
  journaltitle = {The Journal of Immunology},
  volume = {187},
  number = {10},
  pages = {5357--5362},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1100917},
  url = {https://academic.oup.com/jimmunol/article/187/10/5357/7977224},
  urldate = {2026-05-22},
  abstract = {Abstract             Excessive inflammation during bacterial and viral infections is destructive to the host and involves elevated production of proinflammatory cytokines. It is especially deleterious in organs with space constraints such as lung and the CNS. Indeed, a number of viruses that infect lungs, such as avian influenza virus, SARS-associated coronavirus, and respiratory syncytial virus, elicit a very high level of proinflammatory cytokines; however, it is unclear what triggers their production. In this study, we show that IL-17 commonly produced during viral infection specifically augments a proinflammatory response by directly synergizing with antiviral signaling. Costimulation of primary human fibroblasts with IL-17 greatly enhanced respiratory syncytial virus-induced or synthetic dsRNA-based viral mimic polyinosinic:polycytidylic acid-induced expression of proinflammatory genes without affecting expression of IFN-β–stimulated or IFN-stimulated genes. Knockdown of expression of known mediators of the antiviral signaling pathway revealed that the IL-17–poly(I:C) synergy depends on the presence of the transcriptional factors RelA and IFN regulatory factor 3 and IκB kinases. Moreover, this synergy was blocked by an IκB kinase inhibitor, BAY 11-7082. These findings shed light on the molecular mechanisms behind IL-17–dependent immunopathology observed in viral infections.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\UU4VMBVP\Ryzhakov et al. - 2011 - IL-17 Boosts Proinflammatory Outcome of Antiviral Response in Human Cells.pdf}
}

