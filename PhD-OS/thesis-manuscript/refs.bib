  file = {C:\Users\hayatumd\Zotero\storage\IAAQG4FT\Pan et al. - 2020 - Using Real‐World Data to Guide Ustekinumab Dosing Strategies for Psoriasis A Prospective Pharmacoki.pdf}
}

