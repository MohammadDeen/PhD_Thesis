@article{mattyasovszkyIFNGR1singleNucleotidePolymorphisms2006,
  title = {{{IFNGR1single}} Nucleotide Polymorphisms in Rheumatoid Arthritis},
  author = {Mattyasovszky, Stefan and Skapenko, Alla and Kalden, Joachim R and Lipsky, Peter E and Schulze-Koops, Hendrik},
