@article{santoroClinicopathologicFeaturesPrimary2025,
  title = {Clinicopathologic {{Features}} of {{Primary Immunodeficiency Monogenic Disease-related Very Early Onset Inflammatory Bowel Disease}}: {{Focus}} on {{Gastrointestinal Histologic Features}} in {{IFIH1 Mutations}}},
  shorttitle = {Clinicopathologic {{Features}} of {{Primary Immunodeficiency Monogenic Disease-related Very Early Onset Inflammatory Bowel Disease}}},
  author = {Santoro, Luisa and Grillo, Federica and D’Armiento, Maria and Buccoliero, Anna Maria and Rocco, Michele and Ferro, Jacopo and Vanoli, Alessandro and Cafferata, Barbara and Macciomei, Maria Cristina and Mescoli, Claudia and Cananzi, Mara and Alaggio, Rita and Fassan, Matteo and Mastracci, Luca and Francalanci, Paola and Parente, Paola},
  date = {2025-11},
  journaltitle = {Advances in Anatomic Pathology},
  volume = {32},
  number = {6},
  pages = {427--435},
  issn = {1072-4109, 1533-4031},
  doi = {10.1097/PAP.0000000000000457},
  url = {https://journals.lww.com/10.1097/PAP.0000000000000457},
  urldate = {2026-05-22},
  abstract = {Very early onset inflammatory bowel disease (VEO-IBD) is a clinical term referring to IBD-like symptomatology arising in children younger than 6 years. VEO-IBD may be due to polygenic etiology in “pure” IBD (Crohn disease-CD and ulcerative colitis-UC), or it may be caused by primary immunodeficiency underlined by monogenic disease. Primary immunodeficiency monogenic diseases have a Mendelian inheritance and affect the immune system with multiorgan morbidity and possible effects on the gastrointestinal system. Primary Immunodeficiency monogenic diseases differ from “pure” IBD as the latter primarily affect the gastrointestinal tract with mitigated extraintestinal symptomatology. Since their first description, primary immunodeficiency monogenic diseases, although rare, have been the subject of increasing interest due to their dramatic phenotype, difficulty in reaching a timely diagnosis, and specific therapeutic approach. In this paper, we present a brief review of primary immunodeficiency monogenic diseases, focusing on to their clinicopathologic features as well as delving, in greater detail, into monogenic diseases caused by               IFIH1               mutations. The clinicopathologic features of 4 patients with               IFIH1               , a gene involved in interferon pathway deficiency, will be described using a histologic pattern of damage approach confirming the need to avoid the histologic diagnosis of VEO-IBD in children younger than 6 years.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\XKRQAEMQ\Santoro et al. - 2025 - Clinicopathologic Features of Primary Immunodeficiency Monogenic Disease-related Very Early Onset In.pdf}
}

