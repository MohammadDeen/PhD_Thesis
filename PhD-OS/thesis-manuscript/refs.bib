  author = {Reuter, Miriam S and Riess, Angelika and Moog, Ute and Briggs, Tracy A and Chandler, Kate E and Rauch, Anita and Stampfer, Miriam and Steindl, Katharina and Gläser, Dieter and Joset, Pascal and {DDD Study} and Krumbiegel, Mandy and Rabe, Harald and Schulte-Mattler, Uta and Bauer, Peter and Beck-Wödl, Stefanie and Kohlhase, Jürgen and Reis, André and Zweier, Christiane},
  date = {2017-01},
  journaltitle = {Journal of Medical Genetics},
  shortjournal = {J Med Genet},
  volume = {54},
  number = {1},
  pages = {64--72},
  issn = {0022-2593, 1468-6244},
