@article{hensenAssociationScanNovel2003,
  title = {Association Scan of the Novel Psoriasis Susceptibility Region on Chromosome 19: Evidence for Both Susceptible and Protective Loci},
  shorttitle = {Association Scan of the Novel Psoriasis Susceptibility Region on Chromosome 19},
  author = {Hensen, P. and Windemuth, C. and Hüffmeier, U. and Rüschendorf, F. and Stadelmann, A. and Hoppe, V. and Fenneker, D. and Ständer, M. and Schmitt‐Egenolf, M. and Wienker, T. F. and Traupe, H. and Reis, A.},
  date = {2003-08},
  journaltitle = {Experimental Dermatology},
  shortjournal = {Experimental Dermatology},
  volume = {12},
  number = {4},
  pages = {490--496},
  issn = {0906-6705, 1600-0625},
  doi = {10.1034/j.1600-0625.2003.00040.x},
  url = {https://onlinelibrary.wiley.com/doi/10.1034/j.1600-0625.2003.00040.x},
  urldate = {2026-05-22},
  abstract = {Abstract:\enspace{}               To follow up the novel psoriasis susceptibility region on chromosome 19 (PSORS6), we performed an association scan for psoriasis vulgaris using 45 evenly spaced DNA microsatellite markers. For this study, a new independent sample of 210 nuclear psoriasis families (trio design) from Northern Germany was recruited. We used the family based association test (FBAT) for an association scan over the chromosome 19 region encompassing 50.8{$\quad$}cM. We obtained a positive association for the markers D19S922 (allele 5,               P               {$\quad$}={$\quad$}0.008) and D19S916 (allele 13,               P               {$\quad$}={$\quad$}0.016), which correspond to the peak of the region identified in a previously performed scan. We identified two novel regions by a single marker, each showing negative association at D19S917 on 19p13.1 (allele 8,               P               {$\quad$}={$\quad$}0.0034) and at D19S425 (allele 9,               P               {$\quad$}={$\quad$}0.0005), compatible with the hypothesis of protective loci. These two novel regions were explored in more detail using novel microsatellite markers at an average distance of 100{$\quad$}kb. A separate analysis distinguishing between familial (               n               {$\quad$}={$\quad$}137) and sporadic (               n               {$\quad$}={$\quad$}73) psoriasis families showed that the familial trios contribute strongly in the region around D19S425 (               P               {$\quad$}={$\quad$}0.004), while the comparably small subset of 73 sporadic trios has a stronger effect at the locus around D19S917 (               P               {$\quad$}={$\quad$}0.026). These studies confirm the existence of a psoriasis susceptibility locus on chromosome 19 and give first evidence for the existence of both susceptible and protective loci in this region. Analysis of a dense marker set from these refined regions will eventually allow identification of the underlying susceptibility alleles.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\JEVDZHX2\Hensen et al. - 2003 - Association scan of the novel psoriasis susceptibility region on chromosome 19 evidence for both su.pdf}
}

