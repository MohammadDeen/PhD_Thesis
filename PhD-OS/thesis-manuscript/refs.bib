@article{wolffInFrameDeletionMissense2011,
  title = {In-{{Frame Deletion}} and {{Missense Mutations}} of the {{C-Terminal Helicase Domain}} of {{{\textbf{{\mkbibemph{SMARCA2}}}}}} in {{Three Patients}} with {{Nicolaides-Baraitser Syndrome}}},
  author = {Wolff, D. and Endele, S. and Azzarello-Burri, S. and Hoyer, J. and Zweier, M. and Schanze, I. and Schmitt, B. and Rauch, A. and Reis, A. and Zweier, C.},
  date = {2011},
  journaltitle = {Molecular Syndromology},
  shortjournal = {Mol Syndromol},
  volume = {2},
  number = {6},
  pages = {237--244},
  issn = {1661-8769, 1661-8777},
  doi = {10.1159/000337323},
  url = {https://karger.com/article/doi/10.1159/000337323},
  urldate = {2026-05-22},
  abstract = {Using high-resolution molecular karyotyping with SNP arrays to identify candidate genes for etiologically unexplained intellectual disability, we identified a 32-kb de novo in-frame deletion of the C-terminal helicase domain of the \mkbibemph{SMARCA2} gene in a patient with severe intellectual disability, epilepsy, sparse hair, prominent joints, and distinct facial anomalies. Sequencing of the gene in patients with a similar phenotype revealed de novo missense mutations in this domain in 2 further patients, pointing to a crucial role of the SMARCA2 C-terminal helicase domain. The clinical features observed in all 3 patients are typical of Nicolaides-Baraitser syndrome, an only rarely reported syndrome with mainly moderate to severe intellectual disability. Notably, one of our patients with a p.Gly1132Asp mutation showed typical morphological features but an exceptional good development with borderline overall IQ and learning difficulties, thus expanding the phenotypic spectrum of Nicolaides-Baraitser syndrome.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\J4KMEKFR\Wolff et al. - 2011 - In-Frame Deletion and Missense Mutations of the C-Terminal Helicase Domain of SMARCA2.pdf}
}

@article{wolfPsoriasisAssociatedPleiotropic2008,
  title = {Psoriasis Is Associated with Pleiotropic Susceptibility Loci Identified in Type {{II}} Diabetes and {{Crohn}} Disease: {{Table}} 1},
  shorttitle = {Psoriasis Is Associated with Pleiotropic Susceptibility Loci Identified in Type {{II}} Diabetes and {{Crohn}} Disease},
  author = {Wolf, N and Quaranta, M and Prescott, N J and Allen, M and Smith, R and Burden, A D and Worthington, J and Griffiths, C E M and Mathew, C G and Barker, J N and Capon, F and Trembath, R C},
  date = {2008-02},
  journaltitle = {Journal of Medical Genetics},
  shortjournal = {J Med Genet},
  volume = {45},
  number = {2},
  pages = {114--116},
  issn = {0022-2593, 1468-6244},
  doi = {10.1136/jmg.2007.053595},
  url = {https://jmg.bmj.com/lookup/doi/10.1136/jmg.2007.053595},
  urldate = {2026-05-22},
  abstract = {Background:                                Psoriasis is an immune-mediated skin disorder that is inherited as a multifactorial trait. Linkage analyses have clearly mapped a primary disease susceptibility locus to the major histocompatibility complex (MHC) region on chromosome 6p21. More recently, whole-genome association studies have identified two non-MHC disease genes (                 IL12B                 and                 IL23R                 ), both of which also confer susceptibility to Crohn disease (CD).                                                        Objective and methods:               To ascertain the genetic overlap between these two inflammatory conditions further, we investigated 15 CD-associated loci in a psoriasis case–control dataset.                                         Results:                                The analysis of 1256 patients and 2938 unrelated controls found significant associations for loci mapping to chromosomes 1q24 (rs12035082, p{$\mkern1mu$}={$\mkern1mu$}0.009), 6p22 (rs6908425, p{$\mkern1mu$}={$\mkern1mu$}0.00015) and 21q22 (rs2836754, p{$\mkern1mu$}={$\mkern1mu$}0.0003). Notably, the marker showing the strongest phenotypic effect (rs6908425) maps to                 CDKAL1                 , a gene also associated with type 2 diabetes.                                                        Conclusions:               These results substantiate emerging evidence for a pleiotropic role for s genes that contribute to the pathogenesis of immune-mediated disorders.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\XDNTNMV6\Wolf et al. - 2008 - Psoriasis is associated with pleiotropic susceptibility loci identified in type II diabetes and Croh.pdf}
}

