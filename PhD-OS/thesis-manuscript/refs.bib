@article{zhaoCaseNonSyndromicCongenital2024,
  title = {A {{Case}} of {{Non-Syndromic Congenital Cataracts Caused}} by a {{Novel MAF Variant}} in the {{C-Terminal DNA-Binding Domain}}—{{Case Report}} and {{Literature Review}}},
  author = {Zhao, Sharon H. and Yap, Kai Lee and Allegretti, Valerie and Drackley, Andy and Ing, Alexander and Gordon, Adam and Skol, Andrew and McMullen, Patrick and Bohnsack, Brenda L. and Kurup, Sudhi P. and Ralay Ranaivo, Hantamalala and Rossen, Jennifer L.},
  date = {2024-05-25},
  journaltitle = {Genes},
