@article{cretuDifferentiatingPsoriaticArthritis2018,
  title = {Differentiating {{Psoriatic Arthritis From Psoriasis Without Psoriatic Arthritis Using Novel Serum Biomarkers}}},
  author = {Cretu, Daniela and Gao, Lisa and Liang, Kun and Soosaipillai, Antoninus and Diamandis, Eleftherios P. and Chandran, Vinod},
  date = {2018-03},
  journaltitle = {Arthritis Care \& Research},
  shortjournal = {Arthritis Care \& Research},
  volume = {70},
