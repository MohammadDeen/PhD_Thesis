@article{sousaPhenotypeGenotypeNicolaides2014,
  title = {Phenotype and Genotype in {{Nicolaides}}–{{Baraitser}} Syndrome},
  author = {Sousa, Sérgio B. and Hennekam, Raoul C. and {the Nicolaides–Baraitser Syndrome International Consortium}},
