@article{diociaiutiCrossSectionalStudyAutosomal2024,
  title = {Cross-{{Sectional Study}} on {{Autosomal Recessive Congenital Ichthyoses}}: {{Association}} of {{Genotype}} with {{Disease Severity}}, {{Phenotypic}}, and {{Ultrastructural Features}} in 74 {{Italian Patients}}},
  shorttitle = {Cross-{{Sectional Study}} on {{Autosomal Recessive Congenital Ichthyoses}}},
  author = {Diociaiuti, Andrea and Corbeddu, Marialuisa and Rossi, Sabrina and Pisaneschi, Elisa and Cesario, Claudia and Condorelli, Angelo Giuseppe and Samela, Tonia and Giancristoforo, Simona and Angioni, Adriano and Zambruno, Giovanna and Novelli, Antonio and Alaggio, Rita and Abeni, Damiano and El Hachem, May},
  date = {2024},
  journaltitle = {Dermatology},
  shortjournal = {Dermatology},
  volume = {240},
  number = {3},
  pages = {397--413},
  issn = {1018-8665, 1421-9832},
  doi = {10.1159/000536366},
  url = {https://karger.com/article/doi/10.1159/000536366},
  urldate = {2026-05-22},
  abstract = {\textbf{\mkbibemph{Background:}} Autosomal recessive congenital ichthyoses (ARCIs) are a clinically heterogeneous group of keratinization disorders characterized by generalized skin scaling due to mutations in at least 12 genes. The aim of our study was to assess disease severity, phenotypic, and ultrastructural features and to evaluate their association with genetic findings in ARCI patients. \textbf{\mkbibemph{Methods:}} Clinical signs and symptoms, and disease severity were scored in a single-center series of patients with a genetic diagnosis of ARCI. Skin ultrastructural findings were reviewed. \textbf{\mkbibemph{Results:}} Seventy-four consecutive patients (mean age 11.0 years, range 0.1–48.8) affected with lamellar ichthyosis (50/74, 67.5\%), congenital ichthyosiform erythroderma (18/74, 24.3\%), harlequin ichthyosis (two/74, 2.7\%), and other minor ARCI subtypes (four/74, 5.4\%) were enrolled. Mutated genes were as follows: \mkbibemph{TGM1} in 18/74 (24.3\%) patients, \mkbibemph{ALOX12B} in 18/74 (24.3\%), \mkbibemph{CYP4F22} in 12/74 (16.2\%), \mkbibemph{ABCA12} in nine/74 (12.2\%), \mkbibemph{ALOXE3} in seven/74 (9.5\%), \mkbibemph{NIPAL4} in seven/74 (9.5\%), and \mkbibemph{CERS3}, \mkbibemph{PNPLA1}, and \mkbibemph{SDR9C7} in 1 patient each (1.4\%). Twenty-five previously undescribed mutations in the different ARCI causative genes, as well as two microduplications in \mkbibemph{TGM1}, and two microdeletions in \mkbibemph{CYP4F22} and \mkbibemph{NIPAL4} were identified. The mean ichthyosis severity score in \mkbibemph{TGM1}- and \mkbibemph{ABCA12}-mutated patients was significantly higher than in all other mutated genes, while the lowest score was observed in \mkbibemph{CYP4F22}-mutated patients. Alopecia, ectropion, and eclabium were significantly associated with \mkbibemph{TGM1} and \mkbibemph{ABCA12} mutations, and large, thick, and brownish scales with \mkbibemph{TGM1} mutations. Among specific phenotypic features, psoriasis-like lesions as well as a trunk reticulate scale pattern and striated keratoderma were present in \mkbibemph{NIPAL4}-mutated patients. Ultrastructural data available for 56 patients showed a 100\% specificity of cholesterol clefts for \mkbibemph{TGM1}-mutated cases and revealed abnormal lamellar bodies in \mkbibemph{SDR9C7} and \mkbibemph{CERS3} patients. \textbf{\mkbibemph{Conclusion:}} Our study expands the phenotypic and genetic characterization of ARCI by the description of statistically significant associations between disease severity, specific clinical signs, and different mutated genes. Finally, we highlighted the presence of psoriasis-like lesions in \mkbibemph{NIPAL4}-ARCI patients as a novel phenotypic feature with diagnostic and possible therapeutic implications.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\QLQV3RMC\Diociaiuti et al. - 2024 - Cross-Sectional Study on Autosomal Recessive Congenital Ichthyoses Association of Genotype with Dis.pdf}
}

