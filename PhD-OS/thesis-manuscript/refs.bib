  title = {Adaptive Immune Responses to {{SARS-CoV-2}} Infection in Severe versus Mild Individuals},
  author = {Zhang, Fan and Gan, Rui and Zhen, Ziqi and Hu, Xiaoli and Li, Xiang and Zhou, Fengxia and Liu, Ying and Chen, Chuangeng and Xie, Shuangyu and Zhang, Bailing and Wu, Xiaoke and Huang, Zhiwei},
  date = {2020-08-14},
  journaltitle = {Signal Transduction and Targeted Therapy},
  shortjournal = {Sig Transduct Target Ther},
  volume = {5},
  number = {1},
  pages = {156},
  issn = {2059-3635},
  doi = {10.1038/s41392-020-00263-y},
  url = {https://www.nature.com/articles/s41392-020-00263-y},
  urldate = {2026-05-22},
  abstract = {Abstract             The global Coronavirus disease 2019 (COVID-19) pandemic caused by SARS-CoV-2 has affected more than eight million people. There is an urgent need to investigate how the adaptive immunity is established in COVID-19 patients. In this study, we profiled adaptive immune cells of PBMCs from recovered COVID-19 patients with varying disease severity using single-cell RNA and TCR/BCR V(D)J sequencing. The sequencing data revealed SARS-CoV-2-specific shuffling of adaptive immune repertories and COVID-19-induced remodeling of peripheral lymphocytes. Characterization of variations in the peripheral T and B cells from the COVID-19 patients revealed a positive correlation of humoral immune response and T-cell immune memory with disease severity. Sequencing and functional data revealed SARS-CoV-2-specific T-cell immune memory in the convalescent COVID-19 patients. Furthermore, we also identified novel antigens that are responsive in the convalescent patients. Altogether, our study reveals adaptive immune repertories underlying pathogenesis and recovery in severe versus mild COVID-19 patients, providing valuable information for potential vaccine and therapeutic development against SARS-CoV-2 infection.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\YZQFIQ4P\Zhang et al. - 2020 - Adaptive immune responses to SARS-CoV-2 infection in severe versus mild individuals.pdf}
}

