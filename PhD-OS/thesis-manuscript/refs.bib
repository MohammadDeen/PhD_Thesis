@article{dehlinInhibitionFmslikeTyrosine2011,
  title = {Inhibition of Fms-like Tyrosine Kinase 3 Alleviates Experimental Arthritis by Reducing Formation of Dendritic Cells and Antigen Presentation},
  author = {Dehlin, Mats and Andersson, Sofia and Erlandsson, Malin and Brisslert, Mikael and Bokarewa, Maria},
