@article{julcaMAP1BRelatedSyndrome2019,
  title = {{{{\mkbibemph{MAP1B}}}} Related Syndrome: {{Case}} Presentation and Review of Literature},
  shorttitle = {{{{\mkbibemph{MAP1B}}}} Related Syndrome},
  author = {Julca, Diana M. and Diaz, Jullianne and Berger, Seth and Leon, Eyby},
  date = {2019-09},
  journaltitle = {American Journal of Medical Genetics Part A},
