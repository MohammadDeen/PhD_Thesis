@article{daleFamilialAicardiGoutieres2010,
  title = {Familial {{Aicardi}}–{{Goutières}} Syndrome Due to {{{\mkbibemph{SAMHD1}}}} Mutations Is Associated with Chronic Arthropathy and Contractures},
  author = {Dale, Russell C. and Gornall, Hannah and Singh‐Grewal, Davinder and Alcausin, Melanie and Rice, Gillian I. and Crow, Yanick J.},
