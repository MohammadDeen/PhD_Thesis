@online{ram-mohanIntegrativeProfilingEarly2020,
  title = {Integrative Profiling of Early Host Chromatin Accessibility Responses in Human Neutrophils with Sensitive Pathogen Detection},
  author = {Ram-Mohan, Nikhil and Thair, Simone A. and Litzenburger, Ulrike M. and Cogill, Steven and Andini, Nadya and Yang, Xi and Chang, Howard Y. and Yang, Samuel},
