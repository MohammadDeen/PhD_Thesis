@article{johanssonMyeloperoxidaseMediatesCell1997,
  title = {Myeloperoxidase Mediates Cell Adhesion via the {{αMβ2}} Integrin ({{Mac-1}}, {{CD11b}}/{{CD18}})},
  author = {Johansson, Mats W. and Patarroyo, Manuel and Öberg, Fredrik and Siegbahn, Agneta and Nilsson, Kenneth},
  date = {1997-05-01},
  journaltitle = {Journal of Cell Science},
  volume = {110},
  number = {9},
  pages = {1133--1139},
  issn = {0021-9533, 1477-9137},
  doi = {10.1242/jcs.110.9.1133},
  url = {https://journals.biologists.com/jcs/article/110/9/1133/25293/Myeloperoxidase-mediates-cell-adhesion-via-the-M-2},
  urldate = {2026-05-22},
  abstract = {ABSTRACT             Myeloperoxidase is a leukocyte component able to generate potent microbicidal substances. A homologous invertebrate blood cell protein, peroxinectin, is not only a peroxidase but also a cell adhesion ligand. We demonstrate in this study that human myeloperoxidase also mediates cell adhesion. Both the human myeloid cell line HL-60, when differentiated by treatment with 12-O-tetradecanoyl-phorbol-13-acetate (TPA) or retinoic acid, and human blood leukocytes, adhered to myeloperoxidase; however, undifferentiated HL-60 cells showed only minimal adhesion. No cells adhered to horseradish peroxidase, and cell adhesion to myeloperoxidase was not decreased by catalase, thus showing that peroxidase activity, per se, was neither sufficient nor necessary for the adhesion activity. Mannan, which has been reported to inhibit the binding of peroxidases to cells, did not affect adhesion to myeloperoxidase. However, adhesion to myeloperoxidase was inhibited by monoclonal antibodies to αM (CD11b) or to β2 (CD18) integrin subunits, but not by antibodies to αb (CD11a), αx (CD11c), or to other integrins. Native myeloperoxidase mediated dosedependent cell adhesion down to relatively low concentrations, and denaturation abolished the adhesion activity. It is evident that myeloperoxidase supports cell adhesion, a function which may be of considerable importance for leukocyte migration and infiltration in inflammatory reactions, that αMβ2 integrin (Mac-1 or CD11b/CD18) mediates this adhesion, and that the αMβ2 integrin-mediated adhesion to myeloperoxidase is distinct from the previously reported ability of this integrin to bind to certain denatured proteins at high concentrations.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\ITDWNBFB\Johansson et al. - 1997 - Myeloperoxidase mediates cell adhesion via the αMβ2 integrin (Mac-1, CD11bCD18).pdf}
}

@article{johnson75MbDuplicationChromosome2015,
  title = {A 7.5‐{{Mb}} Duplication at Chromosome 11q21‐11q22.3 Is Associated with a Novel Spastic Ataxia Syndrome},
  author = {Johnson, Janel O. and Stevanin, Giovanni and Van De Leemput, Joyce and Hernandez, Dena G. and Arepalli, Sampath and Forlani, Sylvie and Zonozi, Reza and Gibbs, J. Raphael and Brice, Alexis and Durr, Alexandra and Singleton, Andrew B.},
