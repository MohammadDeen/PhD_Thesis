@article{sockelVEXASSyndromeComplete2024,
  title = {{{VEXAS}} Syndrome: Complete Molecular Remission after Hypomethylating Therapy},
  shorttitle = {{{VEXAS}} Syndrome},
  author = {Sockel, Katja and Götze, Katharina and Ganster, Christina and Bill, Marius and Georgi, Julia-Annabell and Balaian, Ekaterina and Aringer, Martin and Trautmann-Grill, Karolin and Uhlig, Maria and Bornhäuser, Martin and Haase, Detlef and Thiede, Christian},
