@article{oroakMultiplexTargetedSequencing2012,
  title = {Multiplex {{Targeted Sequencing Identifies Recurrently Mutated Genes}} in {{Autism Spectrum Disorders}}},
  author = {O’Roak, Brian J. and Vives, Laura and Fu, Wenqing and Egertson, Jarrett D. and Stanaway, Ian B. and Phelps, Ian G. and Carvill, Gemma and Kumar, Akash and Lee, Choli and Ankenman, Katy and Munson, Jeff and Hiatt, Joseph B. and Turner, Emily H. and Levy, Roie and O’Day, Diana R. and Krumm, Niklas and Coe, Bradley P. and Martin, Beth K. and Borenstein, Elhanan and Nickerson, Deborah A. and Mefford, Heather C. and Doherty, Dan and Akey, Joshua M. and Bernier, Raphael and Eichler, Evan E. and Shendure, Jay},
  date = {2012-12-21},
  journaltitle = {Science},
  shortjournal = {Science},
  volume = {338},
  number = {6114},
  pages = {1619--1622},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.1227764},
  url = {https://www.science.org/doi/10.1126/science.1227764},
  urldate = {2026-05-22},
  abstract = {Autism Genes, Again and Again                            Despite recent advances in sequencing technologies and their lowered costs—effective, highly sensitive, and specific sequencing of multiple genes of interest from large cohorts remains expensive.                                O'Roak                 et al.                              (p.               1619               ; published online 15 November) modified molecular inversion probe methods for target-specific capture and sequencing to resequence candidate genes in thousands of patients. The technique was applied to 44 candidate genes to identify de novo mutations in a large cohort of individuals with and without autism spectrum disorder. The analysis revealed several de novo mutations in genes that together contribute to 1\% of sporadic autism spectrum disorders, supporting the notion that multiple genes underlie autism-spectrum disorders.                        ,              Large-scale human autism candidate gene resequencing implicates de novo mutations in six genes in \textasciitilde 1\% of sporadic cases.           ,                             Exome sequencing studies of autism spectrum disorders (ASDs) have identified many de novo mutations but few recurrently disrupted genes. We therefore developed a modified molecular inversion probe method enabling ultra-low-cost candidate gene resequencing in very large cohorts. To demonstrate the power of this approach, we captured and sequenced 44 candidate genes in 2446 ASD probands. We discovered 27 de novo events in 16 genes, 59\% of which are predicted to truncate proteins or disrupt splicing. We estimate that recurrent disruptive mutations in six genes—               CHD8               ,               DYRK1A               ,               GRIN2B               ,               TBR1               ,               PTEN               , and               TBL1XR1               —may contribute to 1\% of sporadic ASDs. Our data support associations between specific genes and reciprocal subphenotypes (               CHD8               -macrocephaly and               DYRK1A               -microcephaly) and replicate the importance of a β-catenin–chromatin-remodeling network to ASD etiology.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\FP9L49SC\O’Roak et al. - 2012 - Multiplex Targeted Sequencing Identifies Recurrently Mutated Genes in Autism Spectrum Disorders.pdf}
}

