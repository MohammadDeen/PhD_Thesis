@article{wilkensNovelClinicalManifestations2012,
  title = {Novel Clinical Manifestations in {{Pallister}}–{{Killian}} Syndrome: {{Comprehensive}} Evaluation of 59 Affected Individuals and Review of Previously Reported Cases},
  shorttitle = {Novel Clinical Manifestations in {{Pallister}}–{{Killian}} Syndrome},
  author = {Wilkens, Alisha and Liu, Hongbin and Park, Kristen and Campbell, Lindsey B. and Jackson, Marie and Kostanecka, Anna and Pipan, Mary and Izumi, Kosuke and Pallister, Phillip and Krantz, Ian D.},
  date = {2012-12},
  journaltitle = {American Journal of Medical Genetics Part A},
