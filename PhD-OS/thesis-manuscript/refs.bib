@article{tsakokDevelopmentAntidrugAntibodies2023,
  title = {Development of Antidrug Antibodies against Adalimumab Maps to Variation within the {{HLA-DR}} Peptide-Binding Groove},
  author = {Tsakok, Teresa and Saklatvala, Jake and Rispens, Theo and Loeff, Floris C. and De Vries, Annick and Allen, Michael H. and Barbosa, Ines A. and Baudry, David and Dasandi, Tejus and Duckworth, Michael and Meynell, Freya and Russell, Alice and Chapman, Anna and McBride, Sandy and McKenna, Kevin and Perera, Gayathri and Ramsay, Helen and Ramesh, Raakhee and Sands, Kathleen and Shipman, Alexa and {the Biomarkers of Systemic Treatment Outcomes in Psoriasis (BSTOP) Study Group} and Burden, A. David and Griffiths, Christopher E.M. and Reynolds, Nick J. and Warren, Richard B. and Mahil, Satveer and Barker, Jonathan and Dand, Nick and Smith, Catherine and Simpson, Michael A.},
