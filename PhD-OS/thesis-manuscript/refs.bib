@article{mclemoreIntroducingMUC16Gene2005,
  title = {Introducing the {{MUC16 Gene}}: {{Implications}} for {{Prevention}} and {{Early Detection}} in {{Epithelial Ovarian Cancer}}},
  shorttitle = {Introducing the {{MUC16 Gene}}},
  author = {McLemore, Monica R. and Aouizerat, Bradley},
  date = {2005-04},
  journaltitle = {Biological Research For Nursing},
