@article{suzukiInsightGenomewideAssociation2011,
  title = {Insight from Genome‐wide Association Studies in Rheumatoid Arthritis and Multiple Sclerosis},
  author = {Suzuki, Akari and Kochi, Yuta and Okada, Yukinari and Yamamoto, Kazuhiko},
  date = {2011-12},
  journaltitle = {FEBS Letters},
  shortjournal = {FEBS Letters},
  volume = {585},
  number = {23},
