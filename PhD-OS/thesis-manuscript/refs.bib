@article{huffmeierNovelAutosomalRecessive2005,
  title = {Novel Autosomal Recessive Progressive Hyperpigmentation Syndrome},
  author = {Hüffmeier, Ulrike and Hausser, Ingrid and Reis, André and Rauch, Anita},
  date = {2005-06},
  journaltitle = {American Journal of Medical Genetics Part A},
  shortjournal = {American J of Med Genetics Pt A},
  volume = {135A},
  number = {2},
  pages = {195--199},
  issn = {1552-4825, 1552-4833},
  doi = {10.1002/ajmg.a.30668},
  url = {https://onlinelibrary.wiley.com/doi/10.1002/ajmg.a.30668},
  urldate = {2026-05-22},
  abstract = {Abstract             We present a family of Iraqui origin with three siblings affected by a novel type of progressive hyperpigmentation syndrome. The generalized initially diffuse, later disseminated hyperpigmentation started in early infancy and increased during childhood. It also affected palms and soles, and the face but spared the cheeks. Additional features were dry, itchy and sunlight sensitive skin, dystrophy of toe nails, hair loss, and myopia, but normal sweat glands. Light and electron microscopy showed signs of pigment incontinence and compound melanosomes as well as fibrillar bodies. The occurrence of this entity in affected siblings from a consanguineous mating suggests autosomal recessive inheritance. Extensive review of the literature showed no previous report with this distinct combination of clinical and microscopic findings. © 2005 Wiley‐Liss, Inc.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\XQZ9THBD\Hüffmeier et al. - 2005 - Novel autosomal recessive progressive hyperpigmentation syndrome.pdf}
}

