@article{kalayyildizhanNewHomozygousMissense2020,
  title = {New {{Homozygous Missense}} {{{\textbf{{\mkbibemph{MSMO1}}}}}} {{Mutation}} in {{Two Siblings}} with {{SC4MOL Deficiency Presenting}} with {{Psoriasiform Dermatitis}}},
  author = {Kalay Yildizhan, Incilay and Gökpınar İli, Ezgi and Onoufriadis, Alexandros and Kocyigit, Pelin and Kesidou, Evangelia and Simpson, Michael A. and McGrath, John A. and Kutlay, Nüket Yürür and Kundakci, Nihal},
  date = {2020},
  journaltitle = {Cytogenetic and Genome Research},
  shortjournal = {Cytogenet Genome Res},
