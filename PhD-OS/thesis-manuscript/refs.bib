@article{chaononghinDisseminatedMycobacteriumScrofulaceum2020,
  title = {Disseminated {{Mycobacterium Scrofulaceum Infection}} in a {{Patient}} with {{Anti-Interferon-γ Autoantibodies}}: A {{Case Report}} and {{Review}} of the {{Literature}}},
  shorttitle = {Disseminated {{Mycobacterium Scrofulaceum Infection}} in a {{Patient}} with {{Anti-Interferon-γ Autoantibodies}}},
  author = {Chaononghin, Surachai and Visuttichaikit, Suttichai and Apisarnthanarak, Anucha and Khawcharoenporn, Thana},
