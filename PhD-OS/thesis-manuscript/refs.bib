  author = {Park, Heon and Staehling-Hampton, Karen and Appleby, Mark W. and Brunkow, Mary E. and Habib, Tania and Zhang, Yi and Ramsdell, Fred and Liggitt, H. Denny and Freie, Brian and Tsang, Mark and Carlson, George and Friend, Sherree and Frevert, Charles and Iritani, Brian M.},
  date = {2008-11-24},
  journaltitle = {The Journal of Experimental Medicine},
  volume = {205},
