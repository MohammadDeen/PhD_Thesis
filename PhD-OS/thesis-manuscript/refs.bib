@article{ricosMutationsMammalianTarget2016,
  title = {Mutations in the Mammalian Target of Rapamycin Pathway Regulators {{{\mkbibemph{NPRL2}}}} and {{{\mkbibemph{NPRL3}}}} Cause Focal Epilepsy},
  author = {Ricos, Michael G. and Hodgson, Bree L. and Pippucci, Tommaso and Saidin, Akzam and Ong, Yeh Sze and Heron, Sarah E. and Licchetta, Laura and Bisulli, Francesca and Bayly, Marta A. and Hughes, James and Baldassari, Sara and Palombo, Flavia and {Epilepsy Electroclinical Study Group} and Santucci, Margherita and Meletti, Stefano and Berkovic, Samuel F. and Rubboli, Guido and Thomas, Paul Q. and Scheffer, Ingrid E. and Tinuper, Paolo and Geoghegan, Joel and Schreiber, Andreas W. and Dibbens, Leanne M.},
  date = {2016-01},
  journaltitle = {Annals of Neurology},
  shortjournal = {Annals of Neurology},
  volume = {79},
  number = {1},
  pages = {120--131},
  issn = {0364-5134, 1531-8249},
  doi = {10.1002/ana.24547},
  url = {https://onlinelibrary.wiley.com/doi/10.1002/ana.24547},
  urldate = {2026-05-22},
  abstract = {Objective                                Focal epilepsies are the most common form observed and have not generally been considered to be genetic in origin. Recently, we identified mutations in                 DEPDC5                 as a cause of familial focal epilepsy. In this study, we investigated whether mutations in the mammalian target of rapamycin (mTOR) regulators,                 NPRL2                 and                 NPRL3                 , also contribute to cases of focal epilepsy.                                                        Methods               We used targeted capture and next‐generation sequencing to analyze 404 unrelated probands with focal epilepsy. We performed exome sequencing on two families with multiple members affected with focal epilepsy and linkage analysis on one of these.                                         Results                                In our cohort of 404 unrelated focal epilepsy patients, we identified five mutations in                 NPRL2                 and five in                 NPRL3                 . Exome sequencing analysis of two families with focal epilepsy identified                 NPRL2                 and                 NPRL3                 as the top candidate‐causative genes. Some patients had focal epilepsy associated with brain malformations. We also identified 18 new mutations in                 DEPDC5                 .                                                        Interpretation                                We have identified                 NPRL2                 and                 NPRL3                 as two new focal epilepsy genes that also play a role in the mTOR‐signaling pathway. Our findings show that mutations in GATOR1 complex genes are the most significant cause of familial focal epilepsy identified to date, including cases with brain malformations. It is possible that deregulation of cellular growth control plays a more important role in epilepsy than is currently recognized. ANN NEUROL 2016;79:120–131},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\GNZ8BSIK\Ricos et al. - 2016 - Mutations in the mammalian target of rapamycin pathway regulators NPRL2 and NPRL3 caus.pdf}
}

