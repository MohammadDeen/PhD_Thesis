@article{jinCombinedEffectsHLACw62009,
  title = {Combined Effects of {{{\mkbibemph{HLA}}}}{\mkbibemph{‐}}{{{\mkbibemph{Cw6}}}} and Cigarette Smoking in Psoriasis Vulgaris: {{A}} Hospital‐based Case–Control Study in {{China}}},
