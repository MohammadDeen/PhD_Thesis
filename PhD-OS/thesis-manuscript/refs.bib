@article{zuoWholeexomeSNPArray2015,
  title = {Whole-Exome {{SNP}} Array Identifies 15 New Susceptibility Loci for Psoriasis},
  author = {Zuo, Xianbo and Sun, Liangdan and Yin, Xianyong and Gao, Jinping and Sheng, Yujun and Xu, Jinhua and Zhang, Jianzhong and He, Chundi and Qiu, Ying and Wen, Guangdong and Tian, Hongqing and Zheng, Xiaodong and Liu, Shengxiu and Wang, Wenjun and Li, Weiran and Cheng, Yuyan and Liu, Longdan and Chang, Yan and Wang, Zaixing and Li, Zenggang and Li, Longnian and Wu, Jianping and Fang, Ling and Shen, Changbing and Zhou, Fusheng and Liang, Bo and Chen, Gang and Li, Hui and Cui, Yong and Xu, Aie and Yang, Xueqin and Hao, Fei and Xu, Limin and Fan, Xing and Li, Yuzhen and Wu, Rina and Wang, Xiuli and Liu, Xiaoming and Zheng, Min and Song, Shunpeng and Ji, Bihua and Fang, Hong and Yu, Jianbin and Sun, Yongxin and Hui, Yan and Zhang, Furen and Yang, Rongya and Yang, Sen and Zhang, Xuejun},
  date = {2015-04-09},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {6},
  number = {1},
  pages = {6793},
  issn = {2041-1723},
  doi = {10.1038/ncomms7793},
  url = {https://www.nature.com/articles/ncomms7793},
  urldate = {2026-05-22},
  abstract = {Abstract                            Genome-wide association studies (GWASs) have reproducibly associated ∼40 susceptibility loci with psoriasis. However, the missing heritability is evident and the contributions of coding variants have not yet been systematically evaluated. Here, we present a large-scale whole-exome array analysis for psoriasis consisting of 42,760 individuals. We discover 16 SNPs within 15 new genes/loci associated with psoriasis, including               C1orf141               ,               ZNF683               ,               TMC6               ,               AIM2               ,               IL1RL1               ,               CASR               ,               SON               ,               ZFYVE16               ,               MTHFR               ,               CCDC129               ,               ZNF143               ,               AP5B1               ,               SYNE2               ,               IFNGR2               and 3q26.2-q27 (               P               {$<$}5.00 × 10               −08               ). In addition, we also replicate four known susceptibility loci               TNIP1               ,               NFKBIA               ,               IL12B               and               LCE3D–LCE3E               . These susceptibility variants identified in the current study collectively account for 1.9\% of the psoriasis heritability. The variant within               AIM2               is predicted to impact protein structure. Our findings increase the number of genetic risk factors for psoriasis and highlight new and plausible biological pathways in psoriasis.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\WIRQQYIY\Zuo et al. - 2015 - Whole-exome SNP array identifies 15 new susceptibility loci for psoriasis.pdf}
}

