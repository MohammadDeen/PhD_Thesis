@article{shinarUniqueSpectrumMEFV2007a,
  title = {Unique Spectrum of {{MEFV}} Mutations in {{Iranian Jewish FMF}} Patients Clinical and Demographic Significance},
  author = {Shinar, Y. and Kuchuk, I. and Menasherow, S. and Kolet, M. and Lidar, M. and Langevitz, P. and Livneh, A.},
  date = {2007-11-01},
  journaltitle = {Rheumatology},
  shortjournal = {Rheumatology},
  volume = {46},
  number = {11},
  pages = {1718--1722},
  issn = {1462-0324, 1462-0332},
  doi = {10.1093/rheumatology/kem228},
  url = {https://academic.oup.com/rheumatology/article-lookup/doi/10.1093/rheumatology/kem228},
  urldate = {2026-05-22},
  abstract = {Objectives. To determine the spectrum of mutations in the Mediterranean fever gene (MEFV) of Iranian Jews with familial Mediterranean fever (FMF) and to analyse their clinical manifestations. Methods. FMF patients with both parents of Iranian-Jewish (IJ) extraction or with one IJ parent (IJ–other, 10 of each) were characterized for clinical manifestations, and the B30.2 (PRYSPRY) domain of their MEFV was sequenced for mutations. Results. Only one rare mutation, R653H, and one new mutation, G632S were present in the IJ group (in 2/10 patients), whereas the new, and common mutations were present in the IJ–other patients (8/10 patients). The new mutation was traced thrice to an IJ ancestor, and although carried asymptomatically by family members, it was over-represented in the patients (3/28 unrelated IJ alleles) compared non-affected IJ subjects (1/126 alleles, P ¼ 0.03) or with non-Jewish Iranians (0/108 alleles, P ¼ 0.001). The mutation was associated with a distinct phenotype regarding sites involved in the attack (P ¼ 0.001), mild severity, sole expression of febrile episodes (P ¼ 0.01) and a male bias (P ¼ 0.01). In two 3D PRYSPRY models the G632S mutation was localized to a surface loop and close to a putative binding site. Conclusions. Iranian Jews with FMF have a unique spectrum of mutations including a newly described mutation with a non-typical phenotype.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\YWUINW3Q\Shinar et al. - 2007 - Unique spectrum of MEFV mutations in Iranian Jewish FMF patients clinical and demographic significan.pdf}
}

@article{shinawiIntragenicCAMTA1Deletions2015,
  title = {Intragenic {\mkbibemph{ }}{{{\mkbibemph{{\textsc{CAMTA1}}}}}}{\mkbibemph{ }} Deletions Are Associated with a Spectrum of Neurobehavioral Phenotypes},
  shorttitle = {Intragenic {\mkbibemph{ }}},
  author = {Shinawi, M. and Coorg, R. and Shimony, J.S. and Grange, D.K. and Al‐Kateb, H.},
  date = {2015-05},
  journaltitle = {Clinical Genetics},
  shortjournal = {Clinical Genetics},
