@article{damianoFrequencyCNKSR22017,
  title = {Frequency of {\mkbibemph{ }}{{{\mkbibemph{{\textsc{CNKSR}}}}}}{\mkbibemph{ 2 }} Mutation in the {{X}}‐linked Epilepsy‐aphasia Spectrum},
  shorttitle = {Frequency Of {\mkbibemph{ }}},
  author = {Damiano, John A. and Burgess, Rosemary and Kivity, Sara and Lerman‐Sagie, Tally and Afawi, Zaid and Scheffer, Ingrid E. and Berkovic, Samuel F. and Hildebrand, Michael S.},
