@article{mirzaaMegalencephalycapillaryMalformationMCAP2012,
  title = {Megalencephaly‐capillary Malformation ({{MCAP}}) and Megalencephaly‐polydactyly‐polymicrogyria‐hydrocephalus ({{MPPH}}) Syndromes: {{Two}} Closely Related Disorders of Brain Overgrowth and Abnormal Brain and Body Morphogenesis},
  shorttitle = {Megalencephaly‐capillary Malformation ({{MCAP}}) and Megalencephaly‐polydactyly‐polymicrogyria‐hydrocephalus ({{MPPH}}) Syndromes},
  author = {Mirzaa, Ghayda M. and Conway, Robert L. and Gripp, Karen W. and Lerman‐Sagie, Tally and Siegel, Dawn H. and {deVries}, Linda S. and Lev, Dorit and Kramer, Nancy and Hopkins, Elizabeth and Graham, John M. and Dobyns, William B.},
  date = {2012-02},
  journaltitle = {American Journal of Medical Genetics Part A},
  shortjournal = {American J of Med Genetics Pt A},
  volume = {158A},
  number = {2},
  pages = {269--291},
  issn = {1552-4825, 1552-4833},
  doi = {10.1002/ajmg.a.34402},
  url = {https://onlinelibrary.wiley.com/doi/10.1002/ajmg.a.34402},
  urldate = {2026-05-22},
  abstract = {Abstract                            The macrocephaly‐capillary malformation syndrome (M‐CM), which we here propose to rename the megalencephaly‐capillary malformation syndrome (MCAP; alternatively the megalencephaly‐capillary malformation‐               polymicrogyria               syndrome), and the more recently described megalencephaly‐polymicrogyria‐polydactyly‐hydrocephalus syndrome (MPPH) are two megalencephaly (MEG) disorders that involve a unique constellation of physical and neuroimaging anomalies. We compare the features in 42 patients evaluated for physical and neuroimaging characteristics of MCAP and MPPH and propose a more global view of these syndromes based on classes of developmental abnormalities that include primary MEG and growth dysregulation, developmental vascular anomalies (primarily capillary malformations), distal limb anomalies (such as syndactyly and polydactyly), cortical brain malformations (most distinctively polymicrogyria, PMG), and variable connective tissue dysplasia. Based on these classes of developmental abnormalities, we propose that MCAP diagnostic criteria include progressive MEG with either vascular anomalies or syndactyly. In parallel, we propose that MPPH diagnostic criteria include progressive MEG and PMG, absence of the vascular anomalies and syndactyly characteristic of MCAP, and absence of brain heterotopia. © 2012 Wiley Periodicals, Inc.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\7ZINUWGV\Mirzaa et al. - 2012 - Megalencephaly‐capillary malformation (MCAP) and megalencephaly‐polydactyly‐polymicrogyria‐hydroceph.pdf}
}

@article{mirzaaPIK3CAassociatedDevelopmentalDisorders2016,
  title = {{{PIK3CA-associated}} Developmental Disorders Exhibit Distinct Classes of Mutations with Variable Expression and Tissue Distribution},
  author = {Mirzaa, Ghayda and Timms, Andrew E. and Conti, Valerio and Boyle, Evan August and Girisha, Katta M. and Martin, Beth and Kircher, Martin and Olds, Carissa and Juusola, Jane and Collins, Sarah and Park, Kaylee and Carter, Melissa and Glass, Ian and Krägeloh-Mann, Inge and Chitayat, David and Parikh, Aditi Shah and Bradshaw, Rachael and Torti, Erin and Braddock, Stephen and Burke, Leah and Ghedia, Sondhya and Stephan, Mark and Stewart, Fiona and Prasad, Chitra and Napier, Melanie and Saitta, Sulagna and Straussberg, Rachel and Gabbett, Michael and O’Connor, Bridget C. and Keegan, Catherine E. and Yin, Lim Jiin and Lai, Angeline Hwei Meeng and Martin, Nicole and McKinnon, Margaret and Addor, Marie-Claude and Boccuto, Luigi and Schwartz, Charles E. and Lanoel, Agustina and Conway, Robert L. and Devriendt, Koenraad and Tatton-Brown, Katrina and Pierpont, Mary Ella and Painter, Michael and Worgan, Lisa and Reggin, James and Hennekam, Raoul and Tsuchiya, Karen and Pritchard, Colin C. and Aracena, Mariana and Gripp, Karen W. and Cordisco, Maria and Van Esch, Hilde and Garavelli, Livia and Curry, Cynthia and Goriely, Anne and Kayserilli, Hulya and Shendure, Jay and Graham, John and Guerrini, Renzo and Dobyns, William B.},
  date = {2016-06-16},
  journaltitle = {JCI Insight},
  volume = {1},
  number = {9},
  pages = {e87623},
  issn = {2379-3708},
  doi = {10.1172/jci.insight.87623},
  url = {https://insight.jci.org/articles/view/87623},
  urldate = {2026-05-22},
  abstract = {Mosaicism is increasingly recognized as a cause of developmental disorders with the advent of next-generation sequencing (NGS). Mosaic mutations of               PIK3CA               have been associated with the widest spectrum of phenotypes associated with overgrowth and vascular malformations. We performed targeted NGS using 2 independent deep-coverage methods that utilize molecular inversion probes and amplicon sequencing in a cohort of 241 samples from 181 individuals with brain and/or body overgrowth. We identified               PIK3CA               mutations in 60 individuals. Several other individuals (               n               = 12) were identified separately to have mutations in               PIK3CA               by clinical targeted-panel testing (               n               = 6), whole-exome sequencing (               n               = 5), or Sanger sequencing (               n               = 1). Based on the clinical and molecular features, this cohort segregated into three distinct groups: (a) severe focal overgrowth due to low-level but highly activating (hotspot) mutations, (b) predominantly brain overgrowth and less severe somatic overgrowth due to less-activating mutations, and (c) intermediate phenotypes (capillary malformations with overgrowth) with intermediately activating mutations. Sixteen of 29               PIK3CA               mutations were novel. We also identified constitutional               PIK3CA               mutations in 10 patients. Our molecular data, combined with review of the literature, show that               PIK3CA               -related overgrowth disorders comprise a discontinuous spectrum of disorders that correlate with the severity and distribution of mutations.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\NMRDI6WJ\Mirzaa et al. - 2016 - PIK3CA-associated developmental disorders exhibit distinct classes of mutations with variable expres.pdf}
}

