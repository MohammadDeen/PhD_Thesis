@article{kumarComparisonLichenSclerosus2022,
  title = {Comparison of Lichen Sclerosus in Boys and Girls: {{A}} Systematic Literature Review of Epidemiology, Symptoms, Genetic Background, Risk Factors, Treatment, and Prognosis},
  shorttitle = {Comparison of Lichen Sclerosus in Boys and Girls},
  author = {Kumar, Kajal S. and Morrel, Beth and Van Hees, Colette L. M. and Van Der Toorn, Fred and Van Dorp, Wendy and Mendels, Elodie J.},
