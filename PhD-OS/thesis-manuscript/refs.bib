  shorttitle = {Brief {{Report}}},
  author = {Tang, Qi and Danila, Maria I. and Cui, Xiangqin and Parks, Lauren and Baker, Brandi J. and Reynolds, Richard J. and Raman, Chander and Wanseck, Keith C. and Redden, David T. and Johnson, Martin R. and {CLEAR Investigators} and Bridges, S. Louis},
