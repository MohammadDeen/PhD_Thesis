@article{cushAdultonsetStillsDisease1987,
  title = {Adult‐onset Still's Disease},
  author = {Cush, John J. and Medsger, Thomas A. and Christy, Wallace C. and Herbert, David C. and Cooperstein, Lawrence A.},
  date = {1987-02},
  journaltitle = {Arthritis \& Rheumatism},
  shortjournal = {Arthritis \& Rheumatism},
  volume = {30},
  number = {2},
  pages = {186--194},
