@article{pirolaGenomewideAnalysisDistinguishes2011,
  title = {Genome-Wide Analysis Distinguishes Hyperglycemia Regulated Epigenetic Signatures of Primary Vascular Cells},
  author = {Pirola, Luciano and Balcerczyk, Aneta and Tothill, Richard W. and Haviv, Izhak and Kaspi, Antony and Lunke, Sebastian and Ziemann, Mark and Karagiannis, Tom and Tonna, Stephen and Kowalczyk, Adam and Beresford-Smith, Bryan and Macintyre, Geoff and Kelong, Ma and Hongyu, Zhang and Zhu, Jingde and El-Osta, Assam},
