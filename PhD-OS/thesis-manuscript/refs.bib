@article{furiaPhenotypicGenotypicSpectrum2024,
  title = {The Phenotypic and Genotypic Spectrum of Individuals with Mono‐ or Biallelic {{{\mkbibemph{ANK3}}}} Variants},
  author = {Furia, Francesca and Levy, Amanda M. and Theunis, Miel and Bamshad, Michael J. and Bartos, Meghan N. and Bijlsma, Emilia K. and Brancati, Francesco and Cejudo, Lucile and Chong, Jessica X. and De Luca, Chiara and Dean, Sarah Joy and Egense, Alena and Goel, Himanshu and Guenzel, Adam J. and Hüffmeier, Ulrike and Legius, Eric and Mancini, Grazia M. S. and Marcos‐Alcalde, Iñigo and Niclass, Tanguy and Planes, Marc and Redon, Sylvia and Ros‐Pardo, David and Rouault, Karen and Schot, Rachel and Schuhmann, Sarah and Shen, Joseph J. and Tao, Alice M. and Thiffault, Isabelle and Van Esch, Hilde and Wentzensen, Ingrid M. and Barakat, Tahsin Stefan and Møller, Rikke S. and Gomez‐Puertas, Paulino and Chung, Wendy K. and Gardella, Elena and Tümer, Zeynep},
  date = {2024-11},
  journaltitle = {Clinical Genetics},
  shortjournal = {Clinical Genetics},
  volume = {106},
  number = {5},
  pages = {574--584},
  issn = {0009-9163, 1399-0004},
  doi = {10.1111/cge.14587},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cge.14587},
  urldate = {2026-05-22},
  abstract = {Abstract                            ANK3               encodes ankyrin‐G, a protein involved in neuronal development and signaling. Alternative splicing gives rise to three ankyrin‐G isoforms comprising different domains with distinct expression patterns. Mono‐ or biallelic               ANK3               variants are associated with non‐specific syndromic intellectual disability in 14 individuals (seven with monoallelic and seven with biallelic variants). In this study, we describe the clinical features of 13 additional individuals and review the data on a total of 27 individuals (16 individuals with monoallelic and 11 with biallelic               ANK3               variants) and demonstrate that the phenotype for biallelic variants is more severe. The phenotypic features include language delay (92\%), autism spectrum disorder (76\%), intellectual disability (78\%), hypotonia (65\%), motor delay (68\%), attention deficit disorder (ADD) or attention deficit hyperactivity disorder (ADHD) (57\%), sleep disturbances (50\%), aggressivity/self‐injury (37.5\%), and epilepsy (35\%). A notable phenotypic difference was presence of ataxia in three individuals with biallelic variants, but in none of the individuals with monoallelic variants. While the majority of the monoallelic variants are predicted to result in a truncated protein, biallelic variants are almost exclusively missense. Moreover, mono‐ and biallelic variants appear to be localized differently across the three different ankyrin‐G isoforms, suggesting isoform‐specific pathological mechanisms.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\3VS8DZ3C\Furia et al. - 2024 - The phenotypic and genotypic spectrum of individuals with mono‐ or biallelic ANK3 variants.pdf}
}

