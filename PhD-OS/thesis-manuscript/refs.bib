@article{johnssonCutaneousLesionsPsoriatic2023,
  title = {Cutaneous Lesions in Psoriatic Arthritis Are Enriched in Chemokine Transcriptomic Pathways},
  author = {Johnsson, Hanna and Cole, John and Siebert, Stefan and McInnes, Iain B. and Graham, Gerard},
  date = {2023-05-02},
  journaltitle = {Arthritis Research \& Therapy},
  shortjournal = {Arthritis Res Ther},
  volume = {25},
  number = {1},
  pages = {73},
  issn = {1478-6362},
  doi = {10.1186/s13075-023-03034-6},
  url = {https://arthritis-research.biomedcentral.com/articles/10.1186/s13075-023-03034-6},
  urldate = {2026-05-22},
  abstract = {Abstract                            Objectives               Skin from people with psoriasis has been extensively studied and is assumed to be identical to skin from those with psoriatic arthritis (PsA). Chemokines and the CC chemokine scavenger receptor ACKR2 are upregulated in uninvolved psoriasis. ACKR2 has been proposed as a regulator of cutaneous inflammation in psoriasis. The aim of this study was to compare the transcriptome of PsA skin to healthy control (HC) skin and evaluate ACKR2 expression in PsA skin.                                         Methods               Full-thickness skin biopsies from HC, lesional and uninvolved skin from participants with PsA were sequenced on NovaSeq 6000. Findings were validated using qPCR and RNAscope.                                         Results               Nine HC and nine paired PsA skin samples were sequenced. PsA uninvolved skin was transcriptionally similar to HC skin, and lesional PsA skin was enriched in epidermal and inflammatory genes. Lesional PsA skin was enriched in chemokine-mediated signalling pathways, but uninvolved skin was not. ACKR2 was upregulated in lesional PsA skin but had unchanged expression in uninvolved compared with HC skin. The expression of ACKR2 was confirmed by qPCR, and RNAscope demonstrated strong expression of ACKR2 in the suprabasal layer of the epidermis in PsA lesions.                                         Conclusion               Chemokines and their receptors are upregulated in lesional PsA skin but relatively unchanged in uninvolved PsA skin. In contrast to previous psoriasis studies, ACKR2 was not upregulated in uninvolved PsA skin. Further understanding of the chemokine system in PsA may help to explain why inflammation spreads from the skin to the joints in some people with psoriasis.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\R2WQL9ZX\Johnsson et al. - 2023 - Cutaneous lesions in psoriatic arthritis are enriched in chemokine transcriptomic pathways.pdf}
}

@article{johnstonIL1F5F6F82011,
  title = {{{IL-1F5}}, -{{F6}}, -{{F8}}, and -{{F9}}: {{A Novel IL-1 Family Signaling System That Is Active}} in {{Psoriasis}} and {{Promotes Keratinocyte Antimicrobial Peptide Expression}}},
  shorttitle = {{{IL-1F5}}, -{{F6}}, -{{F8}}, and -{{F9}}},
  author = {Johnston, Andrew and Xing, Xianying and Guzman, Andrew M and Riblett, MaryBeth and Loyd, Candace M and Ward, Nicole L and Wohn, Christian and Prens, Errol P and Wang, Frank and Maier, Lisa E and Kang, Sewon and Voorhees, John J and Elder, James T and Gudjonsson, Johann E},
  date = {2011-02-15},
  journaltitle = {The Journal of Immunology},
  volume = {186},
  number = {4},
  pages = {2613--2622},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1003162},
  url = {https://academic.oup.com/jimmunol/article/186/4/2613/7990141},
  urldate = {2026-05-22},
  abstract = {Abstract             IL-1F6, IL-1F8, and IL-1F9 and the IL-1R6(RP2) receptor antagonist IL-1F5 constitute a novel IL-1 signaling system that is poorly characterized in skin. To further characterize these cytokines in healthy and inflamed skin, we studied their expression in healthy control, uninvolved psoriasis, and psoriasis plaque skin using quantitative RT-PCR and immunohistochemistry. Expression of IL-1F5, -1F6, -1F8, and -1F9 were increased 2 to 3 orders of magnitude in psoriasis plaque versus uninvolved psoriasis skin, which was supported immunohistologically. Moreover, treatment of psoriasis with etanercept led to significantly decreased IL-1F5, -1F6, -1F8, and -1F9 mRNAs, concomitant with clinical improvement. Similarly increased expression of IL-1F5, -1F6, -1F8, and -1F9 was seen in the involved skin of two mouse models of psoriasis. Suggestive of their importance in inflamed epithelia, IL-1α and TNF-α induced IL-1F5, -1F6, -1F8, and -1F9 transcript expression by normal human keratinocytes. Microarray analysis revealed that these cytokines induce the expression of antimicrobial peptides and matrix metalloproteinases by reconstituted human epidermis. In particular, IL-1F8 increased mRNA expression of human β-defensin (HBD)-2, HBD-3, and CAMP and protein secretion of HBD-2 and HBD-3. Collectively, our data suggest important roles for these novel cytokines in inflammatory skin diseases and identify these peptides as potential targets for antipsoriatic therapies.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\AP7JMHM2\Johnston et al. - 2011 - IL-1F5, -F6, -F8, and -F9 A Novel IL-1 Family Signaling System That Is Active in Psoriasis and Prom.pdf}
}

