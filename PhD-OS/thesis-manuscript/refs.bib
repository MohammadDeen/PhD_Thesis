@article{schotteliusBiologyTumorNecrosis,
  title = {Biology of Tumor Necrosis Factor-a – Implications for Psoriasis},
  author = {Schottelius, Arndt J G and Moldawer, L and Dinarello, A and Sterry, Wolfram and Iii, Carl K Edwards and Ajg, Schottelius and Ll, Moldawer and Ca, Dinarello},
  abstract = {Numerous recent investigations have pointed to a key role of the proinflammatory, pleiotropic cytokine tumor necrosis factor-a (TNF-a) in host defense and inflammatory processes. TNF overexpression has been found in lesional skin and in the circulation of psoriatic patients, and it was suggested that TNF-a is crucial in this and other immune diseases. Several approaches to inhibit TNF-a activity have been developed. These include three different neutralizing antibodies to TNF-a as well as three different soluble TNF-a receptors with characteristic properties designed to bind the 17-KDa soluble trimeric TNF-a and the 26-KDa membrane-bound form of TNF-a. Clinical trials have demonstrated significant antipsoriatic effects, and it is likely that blocking TNF-a will become an important therapeutic option. The data available from these trials contribute to further understanding of the disease by demonstrating the major role of TNF-a. An in-depth understanding of the regulation of TNF gene expression, protein production, receptor expression, and signaling pathways may lead to further, potentially important novel therapeutic strategies and antipsoriatic active small molecules, suitable for oral application in the future. Here we review the current knowledge of TNF biology, the approaches to inhibit TNF activity, and their clinical and immunological effects in psoriasis. In addition, the host-defense effects and chronic TNFblocking activity are discussed.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\6K8F3FYY\Schottelius et al. - Biology of tumor necrosis factor-a – implications for psoriasis.pdf}
}

