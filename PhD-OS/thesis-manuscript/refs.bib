@article{falik-zaccaiBroadSpectrumDevelopmental2010,
  title = {A Broad Spectrum of Developmental Delay in a Large Cohort of Prolidase Deficiency Patients Demonstrates Marked Interfamilial and Intrafamilial Phenotypic Variability},
  author = {Falik‐Zaccai, Tzipora C. and Khayat, Morad and Luder, Anthony and Frenkel, Pnina and Magen, Daniella and Brik, Riva and Gershoni‐Baruch, Ruth and Mandel, Hanna},
  date = {2010-01},
  journaltitle = {American Journal of Medical Genetics Part B: Neuropsychiatric Genetics},
  shortjournal = {American J of Med Genetics Pt B},
  volume = {153B},
  number = {1},
