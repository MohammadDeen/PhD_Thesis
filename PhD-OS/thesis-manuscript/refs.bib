@article{baerWiedemannSteinerSyndromeMajor2018,
  title = {Wiedemann‐{{Steiner}} Syndrome as a Major Cause of Syndromic Intellectual Disability: {{A}} Study of 33 {{French}} Cases},
  shorttitle = {Wiedemann‐{{Steiner}} Syndrome as a Major Cause of Syndromic Intellectual Disability},
  author = {Baer, S. and Afenjar, A. and Smol, T. and Piton, A. and Gérard, B. and Alembik, Y. and Bienvenu, T. and Boursier, G. and Boute, O. and Colson, C. and Cordier, M.‐P. and Cormier‐Daire, V. and Delobel, B. and Doco‐Fenzy, M. and Duban‐Bedu, B. and Fradin, M. and Geneviève, D. and Goldenberg, A. and Grelet, M. and Haye, D. and Heron, D. and Isidor, B. and Keren, B. and Lacombe, D. and Lèbre, A.‐S. and Lesca, G. and Masurel, A. and Mathieu‐Dramard, M. and Nava, C. and Pasquier, L. and Petit, A. and Philip, N. and Piard, J. and Rondeau, S. and Saugier‐Veber, P. and Sukno, S. and Thevenon, J. and Van‐Gils, J. and Vincent‐Delorme, C. and Willems, M. and Schaefer, E. and Morin, G.},
  date = {2018-07},
  journaltitle = {Clinical Genetics},
  shortjournal = {Clinical Genetics},
  volume = {94},
  number = {1},
  pages = {141--152},
  issn = {0009-9163, 1399-0004},
  doi = {10.1111/cge.13254},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cge.13254},
  urldate = {2026-05-22},
  abstract = {Wiedemann‐Steiner syndrome (WSS) is a rare syndromic condition in which intellectual disability (ID) is associated with hypertrichosis cubiti, short stature, and characteristic facies. Following the identification of the causative gene (               KMT2A               ) in 2012, only 31 cases of WSS have been described precisely in the literature. We report on 33 French individuals with a               KMT2A               mutation confirmed by targeted gene sequencing, high‐throughput sequencing or exome sequencing. Patients' molecular and clinical features were recorded and compared with the literature data. On the molecular level, we found 29 novel mutations. We observed autosomal dominant transmission of WSS in 3 families and mosaicism in one family. Clinically, we observed a broad phenotypic spectrum with regard to ID (mild to severe), the facies (typical or not of WSS) and associated malformations (bone, cerebral, renal, cardiac and ophthalmological anomalies). Hypertrichosis cubiti that was supposed to be pathognomonic in the literature was found only in 61\% of our cases. This is the largest series of WSS cases yet described to date. A majority of patients exhibited suggestive features, but others were less characteristic, only identified by molecular diagnosis. The prevalence of WSS was higher than expected in patients with ID, suggesting than               KMT2A               is a major gene in ID.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\S3ZKH2GC\Baer et al. - 2018 - Wiedemann‐Steiner syndrome as a major cause of syndromic intellectual disability A study of 33 Fren.pdf}
}

