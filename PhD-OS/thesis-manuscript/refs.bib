  author = {Magg, Thomas and Shcherbina, Anna and Arslan, Duran and Desai, Mukesh M and Wall, Sarah and Mitsialis, Vanessa and Conca, Raffaele and Unal, Ekrem and Karacabey, Neslihan and Mukhina, Anna and Rodina, Yulia and Taur, Prasad D and Illig, David and Marquardt, Benjamin and Hollizeck, Sebastian and Jeske, Tim and Gothe, Florian and Schober, Tilmann and Rohlfs, Meino and Koletzko, Sibylle and Lurz, Eberhard and Muise, Aleixo M and Snapper, Scott B and Hauck, Fabian and Klein, Christoph and Kotlarz, Daniel},
  date = {2019-10-18},
  journaltitle = {Inflammatory Bowel Diseases},
  volume = {25},
