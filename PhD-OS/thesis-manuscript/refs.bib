@article{zhouVSetImmunoglobulinDomain2022,
  title = {V-{{Set}} and Immunoglobulin Domain Containing ({{VSIG}}) Proteins as Emerging Immune Checkpoint Targets for Cancer Immunotherapy},
  author = {Zhou, Xia and Khan, Sohail and Huang, Dabing and Li, Lu},
  date = {2022-09-15},
  journaltitle = {Frontiers in Immunology},
  shortjournal = {Front. Immunol.},
  volume = {13},
  pages = {938470},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2022.938470},
  url = {https://www.frontiersin.org/articles/10.3389/fimmu.2022.938470/full},
  urldate = {2026-05-22},
  abstract = {The development of immune checkpoint inhibitors is becoming a promising approach to fight cancers. Antibodies targeting immune checkpoint proteins such as CTLA-4 and PD-1 can reinvigorate endogenous antitumor T-cell responses and bring durable advantages to several malignancies. However, only a small subset of patients benefit from these checkpoint inhibitors. Identification of new immune checkpoints with the aim of combination blockade of multiple immune inhibitory pathways is becoming necessary to improve efficiency. Recently, several B7 family-related proteins, TIGIT, VSIG4, and VSIG3, which belong to the VSIG family, have attracted substantial attention as coinhibitory receptors during T-cell activation. By interacting with their corresponding ligands, these VSIG proteins inhibit T-cell responses and maintain an immune suppressive microenvironment in tumors. These results indicated that VSIG family members are becoming putative immune checkpoints in cancer immunotherapy. In this review, we summarized the function of each VSIG protein in regulating immune responses and in tumor progression, thus providing an overview of our current understanding of VSIG family members.},
  file = {C:\Users\hayatumd\Zotero\storage\4K9T8U3B\Zhou et al. - 2022 - V-Set and immunoglobulin domain containing (VSIG) proteins as emerging immune checkpoint targets for.pdf}
}

@article{zhuMolecularStructureRole2022,
  title = {The {{Molecular Structure}} and {{Role}} of {{Humanin}} in {{Neural}} and {{Skeletal Diseases}}, and in {{Tissue Regeneration}}},
  author = {Zhu, Sipin and Hu, Xiaoyong and Bennett, Samuel and Xu, Jiake and Mai, Yuliang},
  date = {2022-03-16},
  journaltitle = {Frontiers in Cell and Developmental Biology},
  shortjournal = {Front. Cell Dev. Biol.},
  volume = {10},
  pages = {823354},
  issn = {2296-634X},
  doi = {10.3389/fcell.2022.823354},
  url = {https://www.frontiersin.org/articles/10.3389/fcell.2022.823354/full},
  urldate = {2026-05-22},
  abstract = {Humanin (HN) belongs to a member of mitochondrial-derived peptides (MDPs) which are encoded by mitochondrial genes. HN shares sequence homology with thirteen HN-like proteins, named MTRNR2L1 to MTRNR2L13, which encompass 24–28 amino acid residues in length. HN mediates mitochondrial status and cell survival by acting               via               an intracellular mechanism, or as a secreted factor via extracellular signals. Intracellularly, it binds Bcl2-associated X protein (BAX), Bim and tBid, and IGFBP3 to inhibit caspase activity and cell apoptosis. When released from cells as a secreted peptide, HN interacts with G protein-coupled formyl peptide receptor-like 1 (FPRL1/2) to mediate apoptosis signal-regulating kinase (ASK) and c-Jun N-terminal kinase (JNK) signalling pathways. Additionally, it interacts with CNTFR-α/gp130/WSX-1 trimeric receptors to induce JAK2/STA3 signalling cascades. HN also binds soluble extracellular proteins such as VSTM2L and IGFBP3 to modulate cytoprotection. It is reported that HN plays a role in neuronal disorders such as Alzheimer’s disease, as well as in diabetes mellitus, infertility, and cardiac diseases. Its roles in the skeletal system are emerging, where it appears to be involved with the regulation of osteoclasts, osteoblasts, and chondrocytes. Understanding the molecular structure and role of HN in neural and skeletal diseases is vital to the application of HN in tissue regeneration.},
  file = {C:\Users\hayatumd\Zotero\storage\SWIVKME8\Zhu et al. - 2022 - The Molecular Structure and Role of Humanin in Neural and Skeletal Diseases, and in Tissue Regenerat.pdf}
}

