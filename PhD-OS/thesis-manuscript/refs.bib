}

@article{huReactiveOxygenSpecies2017,
  title = {Reactive {{Oxygen Species Mediated Prostaglandin E}}{\textsubscript{2}} {{Contributes}} to {{Acute Response}} of {{Epithelial Injury}}},
  author = {Hu, Yi-Ping and Peng, Yin-Bo and Zhang, Yi-Fan and Wang, Ying and Yu, Wei-Rong and Yao, Min and Fu, Xiu-Jun},
