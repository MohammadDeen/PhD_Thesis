@article{daigleMolecularCharacterizationHuman2009,
  title = {Molecular Characterization of a Human cation‐{{Cl}}{\textsuperscript{−}} Cotransporter ({{SLC12A8A}}, {{CCC9A}}) That Promotes Polyamine and Amino Acid Transport},
  author = {Daigle, Nikolas D. and Carpentier, Gabriel A. and Frenette‐Cotton, Rachelle and Simard, Michael G. and Lefoll, Marie‐Hélène and Noël, Micheline and Caron, Luc and Noël, Josette and Isenring, Paul},
