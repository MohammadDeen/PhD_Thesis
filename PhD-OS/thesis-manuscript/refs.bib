@article{olearyHLAB27AssociatedCNO2023,
  title = {{{HLA-B}}*27 Is Associated with {{CNO}} in a {{European}} Cohort},
  author = {O’Leary, Daire and Al Julandani, Dalila Ali and Zia, Muhammad and Klotsche, Jens and Minden, Kirsten and Roderick, Marion and Ramanan, Athimalaipet V. and Killeen, Orla G. and Wilson, Anthony G.},
  date = {2023-06-05},
  journaltitle = {Pediatric Rheumatology},
  shortjournal = {Pediatr Rheumatol},
  volume = {21},
  number = {1},
  pages = {52},
  issn = {1546-0096},
  doi = {10.1186/s12969-023-00826-7},
  url = {https://ped-rheum.biomedcentral.com/articles/10.1186/s12969-023-00826-7},
  urldate = {2026-05-22},
  abstract = {Abstract                            Objectives               To determine the influence of HLA-B27 positivity on risk of developing chronic nonbacterial osteomyelitis (CNO).                                         Methods               HLA-B*27 genotype was assessed in 3 European CNO populations and compared with local control populations (572 cases, 33,256 controls). Regional or whole-body MRI was performed at diagnosis and follow-up in all cases which reduces the risk of disease misclassification. Genotyping was performed using either next generation DNA sequencing or PCR based molecular typing. Statistical analysis used Fisher’s exact test with Bonferroni correction and a fixed effects model for meta-analysis of odds ratios.                                         Results                                HLA-B*27 frequency was higher in all 3 populations compared with local controls (combined odds ratio (OR)\,=\,2.2,                 p                 -value\,=\,3\,×\,10                 –11                 ). This association was much stronger in male compared with female cases (OR\,=\,1.99, corrected                 p                 -value\,=\,0.015). However, the HLA-B*27 status was not statistically significantly associated with co-occurrence of psoriasis, arthritis or inflammatory bowel disease.                                                        Conclusion               Carriage of HLA-B*27 is associated with greater risk of developing CNO, particularly in male cases.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\PVBXSP4Q\O’Leary et al. - 2023 - HLA-B27 is associated with CNO in a European cohort.pdf}
}

