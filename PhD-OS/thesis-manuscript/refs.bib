@article{pachlopnikschmidPolymeraseE1Mutation2012,
  title = {Polymerase ε1 Mutation in a Human Syndrome with Facial Dysmorphism, Immunodeficiency, Livedo, and Short Stature (“{{FILS}} Syndrome”)},
  author = {Pachlopnik Schmid, Jana and Lemoine, Roxane and Nehme, Nadine and Cormier-Daire, Valéry and Revy, Patrick and Debeurme, Franck and Debré, Marianne and Nitschke, Patrick and Bole-Feysot, Christine and Legeai-Mallet, Laurence and Lim, Annick and De Villartay, Jean-Pierre and Picard, Capucine and Durandy, Anne and Fischer, Alain and De Saint Basile, Geneviève},
  date = {2012-12-17},
  journaltitle = {Journal of Experimental Medicine},
  volume = {209},
  number = {13},
  pages = {2323--2330},
  issn = {1540-9538, 0022-1007},
  doi = {10.1084/jem.20121303},
  url = {https://rupress.org/jem/article/209/13/2323/41015/Polymerase-1-mutation-in-a-human-syndrome-with},
  urldate = {2026-05-22},
  abstract = {DNA polymerase ε (Polε) is a large, four-subunit polymerase that is conserved throughout the eukaryotes. Its primary function is to synthesize DNA at the leading strand during replication. It is also involved in a wide variety of fundamental cellular processes, including cell cycle progression and DNA repair/recombination. Here, we report that a homozygous single base pair substitution in POLE1 (polymerase ε 1), encoding the catalytic subunit of Polε, caused facial dysmorphism, immunodeficiency, livedo, and short stature (“FILS syndrome”) in a large, consanguineous family. The mutation resulted in alternative splicing in the conserved region of intron 34, which strongly decreased protein expression of Polε1 and also to a lesser extent the Polε2 subunit. We observed impairment in proliferation and G1- to S-phase progression in patients’ T lymphocytes. Polε1 depletion also impaired G1- to S-phase progression in B lymphocytes, chondrocytes, and osteoblasts. Our results evidence the developmental impact of a Polε catalytic subunit deficiency in humans and its causal relationship with a newly recognized, inherited disorder.},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\28F77IBZ\Pachlopnik Schmid et al. - 2012 - Polymerase ε1 mutation in a human syndrome with facial dysmorphism, immunodeficiency, livedo, and sh.pdf}
}

