  title = {Mutations in the {{{\textsc{IRBIT}}}} Domain of {\mkbibemph{ }}{{{\mkbibemph{{\textsc{ITPR1}}}}}}{\mkbibemph{ }} Are a Frequent Cause of Autosomal Dominant Nonprogressive Congenital Ataxia},
  shorttitle = {Mutations in The},
  author = {Barresi, S. and Niceta, M. and Alfieri, P. and Brankovic, V. and Piccini, G. and Bruselles, A. and Barone, M.R. and Cusmai, R. and Tartaglia, M. and Bertini, E. and Zanni, G.},
