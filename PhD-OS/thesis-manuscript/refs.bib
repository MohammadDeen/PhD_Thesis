  author = {Jakubiuk‐Tomaszuk, Anna and Murcia Pienkowski, Victor and Zietkiewicz, Szymon and Rydzanicz, Małgorzata and Kosińska, Joanna and Stawiński, Piotr and Szumiński, Michał and Płoski, Rafał},
