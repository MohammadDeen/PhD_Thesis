@article{cadoffMechanisticInsightsCellular2018,
  title = {Mechanistic Insights into the Cellular Effects of a Novel {{{\mkbibemph{FN1}}}} Variant Associated with a Spondylometaphyseal Dysplasia},
  author = {Cadoff, E.B. and Sheffer, R. and Wientroub, S. and Ovadia, D. and Meiner, V. and Schwarzbauer, J.E.},
  date = {2018-11},
  journaltitle = {Clinical Genetics},
