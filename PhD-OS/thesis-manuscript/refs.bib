  shorttitle = {Genotype–Phenotype Correlations in {{Darier}} Disease},
  author = {Gordon‐Smith, Katherine and Green, Elaine and Grozeva, Detelina and Tavadia, Sherine and Craddock, Nick and Jones, Lisa},
