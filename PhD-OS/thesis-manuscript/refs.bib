@article{wolfUNC93B1VariantsUnderlie2024,
  title = {{{UNC93B1}} Variants Underlie {{TLR7-dependent}} Autoimmunity},
  author = {Wolf, Christine and Lim, Ee Lyn and Mokhtari, Mohammad and Kind, Barbara and Odainic, Alexandru and Lara-Villacanas, Eusebia and Koss, Sarah and Mages, Simon and Menzel, Katharina and Engel, Kerstin and Dückers, Gregor and Bernbeck, Benedikt and Schneider, Dominik T. and Siepermann, Kathrin and Niehues, Tim and Goetzke, Carl Christoph and Durek, Pawel and Minden, Kirsten and Dörner, Thomas and Stittrich, Anna and Szelinski, Franziska and Guerra, Gabriela Maria and Massoud, Mona and Bieringer, Markus and De Oliveira Mann, Carina C. and Beltrán, Eduardo and Kallinich, Tilmann and Mashreghi, Mir-Farzin and Schmidt, Susanne V. and Latz, Eicke and Klughammer, Johanna and Majer, Olivia and Lee-Kirsch, Min Ae},
  date = {2024-02-23},
  journaltitle = {Science Immunology},
  shortjournal = {Sci. Immunol.},
  volume = {9},
  number = {92},
  pages = {eadi9769},
  issn = {2470-9468},
  doi = {10.1126/sciimmunol.adi9769},
  url = {https://www.science.org/doi/10.1126/sciimmunol.adi9769},
  urldate = {2026-05-22},
  abstract = {UNC93B1 is critical for trafficking and function of nucleic acid–sensing Toll-like receptors (TLRs) TLR3, TLR7, TLR8, and TLR9, which are essential for antiviral immunity. Overactive TLR7 signaling induced by recognition of self–nucleic acids has been implicated in systemic lupus erythematosus (SLE). Here, we report UNC93B1 variants (E92G and R336L) in four patients with early-onset SLE. Patient cells or mouse macrophages carrying the UNC93B1 variants produced high amounts of TNF-α and IL-6 and upon stimulation with TLR7/TLR8 agonist, but not with TLR3 or TLR9 agonists. E92G causes UNC93B1 protein instability and reduced interaction with TLR7, leading to selective TLR7 hyperactivation with constitutive type I IFN signaling. Thus, UNC93B1 regulates TLR subtype–specific mechanisms of ligand recognition. Our findings establish a pivotal role for UNC93B1 in TLR7-dependent autoimmunity and highlight the therapeutic potential of targeting TLR7 in SLE.           ,              UNC93B1 prevents human lupus by restraining uncontrolled TLR7 activation.           ,              Editor’s summary                            Toll-like receptor (TLR) 7 activates innate immune signaling after recognition of endosomal single-stranded RNA but is also believed to contribute to the development of autoimmunity. In four patients with childhood-onset lupus, Wolf               et al               . identified variants in the transmembrane chaperone protein UNC93B1 that led to TLR7 hyperactivation and constitutive type I interferon production. Mishra               et al               . also identified a patient with lupus bearing a mutation in UNC93B1 that disrupted its interaction with the endosomal BORC complex, which they found controlled homeostatic TLR7 turnover. Together, these findings demonstrate that disruptions to TLR7’s regulatory machinery can contribute to human autoimmune disease. See related Research Article by Mishra               et al               . in this issue. —Claire Olingy},
  langid = {english},
  file = {C:\Users\hayatumd\Zotero\storage\67VWCJ3I\Wolf et al. - 2024 - UNC93B1 variants underlie TLR7-dependent autoimmunity.pdf}
}

