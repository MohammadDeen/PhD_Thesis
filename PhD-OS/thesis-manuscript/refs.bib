@article{huppkeActivatingNovoMutations2017,
  title = {Activating de Novo Mutations in {{NFE2L2}} Encoding {{NRF2}} Cause a Multisystem Disorder},
  author = {Huppke, Peter and Weissbach, Susann and Church, Joseph A. and Schnur, Rhonda and Krusen, Martina and Dreha-Kulaczewski, Steffi and Kühn-Velten, W. Nikolaus and Wolf, Annika and Huppke, Brenda and Millan, Francisca and Begtrup, Amber and Almusafri, Fatima and Thiele, Holger and Altmüller, Janine and Nürnberg, Peter and Müller, Michael and Gärtner, Jutta},
