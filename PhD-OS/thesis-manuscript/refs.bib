@article{jiangAutosomalDominantSLURP12025,
  title = {Autosomal Dominant {{{\mkbibemph{SLURP1}}}} Variants Cause Palmoplantar Keratoderma and Progressive Symmetric Erythrokeratoderma},
  author = {Jiang, Xingyuan and Mortlock, Ryland D and Lomakin, Ivan B and Zhou, Jing and Hu, Ronghua and Cossio, María Laura and Bunick, Christopher G and Choate, Keith A},
