  title = {Systematic Survey of Variants in {{{\mkbibemph{TBX1}}}} in Non-Syndromic Tetralogy of {{Fallot}} Identifies a Novel 57 Base Pair Deletion That Reduces Transcriptional Activity but Finds No Evidence for Association with Common Variants},
